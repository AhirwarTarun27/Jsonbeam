---
/**
 * The shared JSON workbench island. Framework-free: markup + a single
 * client-side module that mounts CodeMirror 6. Does format / minify / repair /
 * validate with inline error squiggles. All processing is local — nothing is
 * uploaded. In-app controls use the 6px radius scale (not marketing pills).
 *
 * The `variant` prop re-skins behavior for each landing page (validator,
 * minifier, repair, beautifier) without re-bundling: it picks the primary
 * (ink) toolbar button, what Ctrl+S runs, and — for repair — a broken default
 * document so the payoff is one click away.
 */
import type { ToolVariant } from '../consts';

interface Props {
	variant?: ToolVariant;
}

const { variant = 'format' } = Astro.props;
// 'beautify' is the formatter's Format action under a search-friendlier name.
const primaryAction: 'format' | 'minify' | 'validate' | 'repair' =
	variant === 'beautify' ? 'format' : variant;
---

<div
	id="jb-formatter"
	data-variant={variant}
	class="overflow-hidden rounded-md border border-hairline bg-canvas shadow-e3"
>
	<!-- Toolbar -->
	<div class="flex flex-wrap items-center gap-1.5 border-b border-hairline bg-canvas-soft px-3 py-2">
		<button type="button" data-action="format" class:list={['jb-btn', { 'jb-btn-primary': primaryAction === 'format' }]} title="Beautify">Format</button>
		<button type="button" data-action="minify" class:list={['jb-btn', { 'jb-btn-primary': primaryAction === 'minify' }]} title="Strip all whitespace">Minify</button>
		<button type="button" data-action="repair" class:list={['jb-btn', { 'jb-btn-primary': primaryAction === 'repair' }]} title="Fix common JSON mistakes">Repair</button>
		<button type="button" data-action="validate" class:list={['jb-btn', { 'jb-btn-primary': primaryAction === 'validate' }]} title="Check for errors">Validate</button>

		<span class="mx-1 hidden h-5 w-px bg-hairline sm:block" aria-hidden="true"></span>

		<label class="flex items-center gap-1.5 text-body-sm text-body">
			<span class="hidden sm:inline">Indent</span>
			<select
				id="jb-indent"
				class="h-8 rounded-sm border border-hairline bg-canvas px-2 text-body-sm text-ink"
				aria-label="Indentation"
			>
				<option value="2">2 spaces</option>
				<option value="4">4 spaces</option>
				<option value="tab">Tab</option>
			</select>
		</label>

		<div class="ml-auto flex items-center gap-1.5">
			<button
				type="button"
				data-action="theme"
				class="jb-btn jb-btn-icon"
				aria-label="Switch to light editor theme"
				title="Toggle dark / light editor"
			><span data-theme-icon aria-hidden="true"></span></button>
			<button type="button" data-action="sample" class="jb-btn" title="Load a messy sample to try Repair">Sample</button>
			<button type="button" data-action="copy" class="jb-btn" title="Copy to clipboard">Copy</button>
			<button type="button" data-action="download" class="jb-btn" title="Download as data.json">Download</button>
			<button type="button" data-action="clear" class="jb-btn" title="Clear the editor">Clear</button>
		</div>
	</div>

	<!-- Editor -->
	<div id="jb-editor" class="h-[74vh] min-h-[460px] w-full overflow-hidden"></div>

	<!-- Status bar -->
	<div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-hairline bg-canvas-soft px-3 py-2 text-body-sm">
		<span id="jb-status" class="inline-flex items-center gap-1.5 font-medium" role="status" aria-live="polite">
			<span class="h-2 w-2 rounded-full bg-mute" data-dot></span>
			<span data-label>Ready</span>
		</span>
		<span id="jb-stats" class="font-mono text-caption text-mute">0 lines · 0 chars</span>
		<span class="ml-auto inline-flex items-center gap-1.5 text-caption text-mute">
			<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M8 1.5 3 3.5v3.2c0 3 2.1 5.8 5 6.8 2.9-1 5-3.8 5-6.8V3.5L8 1.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
			</svg>
			Processed locally — nothing uploaded
		</span>
	</div>
</div>

<style>
	/* .jb-btn / .jb-btn-primary / .jb-btn-icon now live in global.css (shared
	   across islands). Only editor-specific styles remain below. */

	/* Dark by default so the mount area matches the editor before hydration. */
	#jb-editor {
		background-color: var(--color-editor-bg);
	}
	#jb-editor :global(.cm-editor) {
		height: 100%;
	}

	/*
	 * Selection fix. The site-wide ::selection paints an ink block with
	 * near-white text — right for marketing copy, but it washed code out to
	 * near-invisibility inside the editor. Override it per theme so selected
	 * JSON always stays readable (default = dark editor).
	 */
	:global(#jb-editor .cm-editor ::selection) {
		color: var(--color-on-primary);
		background-color: var(--color-editor-sel-dark);
	}
	:global(html.jb-theme-light #jb-editor .cm-editor ::selection) {
		color: var(--color-ink);
		background-color: var(--color-editor-sel-light);
	}

	/* .jb-btn / .jb-btn-icon coarse-pointer inflation is global; only the
	   formatter's indent <select> needs the 44px floor added here. */
	@media (pointer: coarse) {
		#jb-indent { height: 44px; }
	}
</style>

<script>
	import { EditorView, keymap, lineNumbers, highlightActiveLine, highlightActiveLineGutter, highlightSpecialChars } from '@codemirror/view';
	import { Compartment } from '@codemirror/state';
	import { defaultKeymap, history, historyKeymap, indentWithTab } from '@codemirror/commands';
	import { json } from '@codemirror/lang-json';
	import { syntaxHighlighting, HighlightStyle, bracketMatching, foldGutter, foldKeymap, indentUnit, indentOnInput } from '@codemirror/language';
	import { tags as t } from '@lezer/highlight';
	import { lintGutter, linter, type Diagnostic } from '@codemirror/lint';
	import { checkJson } from '../lib/json';
	import { loadDoc, saveDoc } from '../lib/doc-store';
	import { initThemeToggle, getTheme } from '../lib/island-theme';
	import { copyToClipboard } from '../lib/island-clipboard';
	// jsonrepair is lazy-loaded on first Repair click (kept out of the initial bundle).

	const root = document.getElementById('jb-formatter');
	const mount = document.getElementById('jb-editor');
	if (root && mount) {
		// Non-null alias so the narrowing survives into the closures below.
		const editorEl = mount;
		const DEFAULT_DOC = [
			'{',
			'  "app": "JSON Beam",',
			'  "private": true,',
			'  "modes": ["text", "tree", "table", "graph"],',
			'  "maxFileSizeMB": 100',
			'}',
		].join('\n');

		const MESSY_DOC = [
			'{',
			"  app: 'JSON Beam',",
			'  private: true,',
			"  modes: ['text','tree','table','graph',],",
			'  // unquoted keys, single quotes, trailing comma, and this comment',
			'  maxFileSizeMB: 100,',
			'}',
		].join('\n');

		// Variant re-skins behavior (see component frontmatter). On the repair
		// page we open with broken JSON so the fix is one click away.
		const variant = root.dataset.variant ?? 'format';

		// "Paste once" carry: if the user already has a document going (from another
		// tool this session), rehydrate it; otherwise fall back to the variant's
		// demo seed so first-time visitors still land on something to try.
		const carried = loadDoc();
		const INITIAL_DOC = carried !== null ? carried : variant === 'repair' ? MESSY_DOC : DEFAULT_DOC;

		// ── Theme + syntax — dark code workbench (default) or light variant ──
		// Surface + palette mirror DESIGN.md's `code-editor-mockup` and the
		// homepage hero/workbench mockups, so the live editor matches them.
		type Mode = 'dark' | 'light';

		function editorTheme(mode: Mode) {
			const dark = mode === 'dark';
			return EditorView.theme(
				{
					'&': { backgroundColor: dark ? 'var(--color-editor-bg)' : 'var(--color-canvas)', color: dark ? 'var(--color-editor-fg)' : 'var(--color-ink)', colorScheme: dark ? 'dark' : 'light', fontSize: '13px', height: '100%' },
					'&.cm-focused': { outline: 'none', boxShadow: 'inset 0 0 0 2px var(--color-link)' },
					'.cm-scroller': { fontFamily: 'var(--font-mono)', lineHeight: '1.6' },
					'.cm-content': { padding: '14px 0', caretColor: dark ? 'var(--color-editor-fg)' : 'var(--color-ink)' },
					'.cm-gutters': { backgroundColor: dark ? 'var(--color-editor-bg)' : 'var(--color-canvas)', color: dark ? 'var(--color-hairline-strong)' : 'var(--color-mute)', border: 'none', borderRight: dark ? '1px solid rgba(255, 255, 255, 0.08)' : '1px solid var(--color-hairline)' },
					'.cm-lineNumbers .cm-gutterElement': { padding: '0 10px 0 14px' },
					'.cm-activeLine': { backgroundColor: dark ? 'var(--color-editor-line)' : 'var(--color-canvas-soft)' },
					'.cm-activeLineGutter': { backgroundColor: dark ? 'var(--color-editor-line)' : 'var(--color-canvas-soft)', color: dark ? 'var(--color-editor-fg)' : 'var(--color-body)' },
					'.cm-matchingBracket': { backgroundColor: dark ? 'rgba(255, 255, 255, 0.14)' : 'var(--color-canvas-soft-2)', outline: dark ? '1px solid rgba(255, 255, 255, 0.22)' : '1px solid var(--color-hairline-strong)' },
					'.cm-tooltip': { border: dark ? '1px solid rgba(255, 255, 255, 0.12)' : '1px solid var(--color-hairline)', backgroundColor: dark ? 'var(--color-editor-line)' : 'var(--color-canvas)', color: dark ? 'var(--color-editor-fg)' : 'var(--color-ink)', borderRadius: '6px', boxShadow: 'var(--shadow-e4)', overflow: 'hidden' },
					'.cm-diagnostic': { fontFamily: 'var(--font-sans)', fontSize: '13px', padding: '6px 10px' },
					'.cm-diagnostic-error': { borderLeftColor: 'var(--color-error)' },
				},
				{ dark }
			);
		}

		function editorHighlight(mode: Mode) {
			return mode === 'dark'
				? HighlightStyle.define([
						{ tag: t.propertyName, color: 'var(--color-editor-fg)', fontWeight: '500' },
						{ tag: t.string, color: 'var(--color-cyan)' },
						{ tag: t.number, color: 'var(--color-violet-soft)' },
						{ tag: [t.bool, t.null], color: 'var(--color-warning)' },
						{ tag: [t.brace, t.squareBracket, t.punctuation, t.separator], color: 'var(--color-hairline-strong)' },
					])
				: HighlightStyle.define([
						{ tag: t.propertyName, color: 'var(--color-ink)', fontWeight: '500' },
						{ tag: t.string, color: 'var(--color-link-deep)' },
						{ tag: t.number, color: 'var(--color-violet)' },
						{ tag: [t.bool, t.null], color: 'var(--color-cyan-deep)' },
						{ tag: [t.brace, t.squareBracket, t.punctuation, t.separator], color: 'var(--color-mute)' },
					]);
		}

		function themeExtensions(mode: Mode) {
			return [editorTheme(mode), syntaxHighlighting(editorHighlight(mode))];
		}

		// Persisted editor theme — default dark (the developer-native, on-brand
		// surface). Read via the shared island core (lib/island-theme).
		const themeComp = new Compartment();
		const initialTheme = getTheme();

		// ── Large-input valves ───────────────────────────────────────────────
		// Parsing/serializing tens of megabytes blocks the main thread. Above
		// OFFLOAD_BYTES, user-triggered format/minify run in a Web Worker
		// (lib/json-engine, lazy-loaded — zero initial-bundle cost). Above
		// LIVE_VALIDATE_MAX, the on-every-change validation + linting pause, so
		// pasting a huge document never freezes the tab.
		const OFFLOAD_BYTES = 1_048_576; // 1 MB
		const LIVE_VALIDATE_MAX = 4_194_304; // 4 MB
		let busy = false;

		// ── Validation: precise, line-anchored error messages (see lib/json.ts) ─
		function diagnostics(view: EditorView): Diagnostic[] {
			if (view.state.doc.length > LIVE_VALIDATE_MAX) return [];
			const res = checkJson(view.state.doc.toString());
			if (res.ok) return [];
			const len = view.state.doc.length;
			const from = Math.min(Math.max(res.position, 0), len);
			const to = Math.min(from + 1, len);
			return [{ from, to: Math.max(to, from), severity: 'error', message: res.message }];
		}

		// ── Status bar ───────────────────────────────────────────────────────
		const dot = root.querySelector<HTMLElement>('#jb-status [data-dot]');
		const label = root.querySelector<HTMLElement>('#jb-status [data-label]');
		const statsEl = root.querySelector<HTMLElement>('#jb-stats');
		let statusTimer = 0;

		function setStatus(state: 'ok' | 'error' | 'idle', text: string) {
			if (!dot || !label) return;
			const colors: Record<string, string> = { ok: 'var(--color-success)', error: 'var(--color-error)', idle: 'var(--color-mute)' };
			dot.style.backgroundColor = colors[state] || colors.idle;
			label.textContent = text;
			label.style.color = state === 'error' ? 'var(--color-error-deep)' : 'var(--color-ink)';
		}

		function refreshStatus() {
			const text = view.state.doc.toString();
			const lines = view.state.doc.lines;
			const chars = view.state.doc.length;
			if (statsEl) statsEl.textContent = `${lines} lines · ${chars.toLocaleString()} chars`;
			if (text.trim() === '') {
				setStatus('idle', 'Empty');
				return;
			}
			if (chars > LIVE_VALIDATE_MAX) {
				setStatus('idle', 'Large file — validation paused');
				return;
			}
			const res = checkJson(text);
			if (res.ok) setStatus('ok', 'Valid JSON');
			else setStatus('error', res.message);
		}

		// ── Editor configuration ─────────────────────────────────────────────
		const indentComp = new Compartment();
		const indentStrings: Record<string, string> = { '2': '  ', '4': '    ', tab: '\t' };
		let indentKey = '2';

		const view = new EditorView({
			parent: mount,
			doc: INITIAL_DOC,
			extensions: [
				lineNumbers(),
				highlightActiveLineGutter(),
				highlightSpecialChars(),
				history(),
				indentOnInput(),
				bracketMatching(),
				foldGutter(),
				highlightActiveLine(),
				indentComp.of(indentUnit.of(indentStrings[indentKey])),
				json(),
				themeComp.of(themeExtensions(initialTheme)),
				linter(diagnostics, { delay: 350 }),
				lintGutter(),
				keymap.of([...defaultKeymap, ...historyKeymap, ...foldKeymap, indentWithTab]),
				EditorView.contentAttributes.of({ 'aria-label': 'JSON editor', spellcheck: 'false' }),
				EditorView.updateListener.of((u) => {
					if (u.docChanged) {
						clearTimeout(statusTimer);
						statusTimer = window.setTimeout(() => {
							refreshStatus();
							// Carry the working doc to the next tool page (sessionStorage only).
							saveDoc(view.state.doc.toString());
						}, 250);
					}
				}),
				// Ctrl/Cmd+S runs the page's primary action (format/minify/repair/validate).
				keymap.of([{ key: 'Mod-s', preventDefault: true, run: () => { runPrimary(); return true; } }]),
			],
		});

		// ── Actions ────────────────────────────────────────────────────────
		function getText() {
			return view.state.doc.toString();
		}
		function setText(next: string) {
			view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: next } });
			refreshStatus();
		}
		function shakeLabel() {
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (label && !reduce) {
				label.animate(
					[{ transform: 'translateX(0)' }, { transform: 'translateX(-3px)' }, { transform: 'translateX(3px)' }, { transform: 'translateX(0)' }],
					{ duration: 220 }
				);
			}
		}
		function flashInvalid() {
			refreshStatus();
			shakeLabel();
		}
		function spaceArg() {
			return indentKey === 'tab' ? '\t' : parseInt(indentKey, 10);
		}
		// Format (space set) or minify (space null). Small inputs run inline for
		// instant feedback; large ones offload the parse/serialize to a worker so
		// the tab never freezes (see the large-input valves above).
		async function transform(space: string | number | null): Promise<void> {
			if (busy) return;
			const text = getText();
			if (text.trim() === '') return;
			if (text.length <= OFFLOAD_BYTES) {
				try {
					setText(space === null ? JSON.stringify(JSON.parse(text)) : JSON.stringify(JSON.parse(text), null, space));
				} catch {
					flashInvalid();
				}
				return;
			}
			busy = true;
			editorEl.setAttribute('aria-busy', 'true');
			setStatus('idle', space === null ? 'Minifying…' : 'Formatting…');
			try {
				const eng = await import('../lib/json-engine');
				setText(space === null ? await eng.minifyJson(text) : await eng.formatJson(text, space));
			} catch {
				setStatus('error', 'Invalid JSON');
				shakeLabel();
			} finally {
				busy = false;
				editorEl.removeAttribute('aria-busy');
			}
		}
		function doFormat() {
			void transform(spaceArg());
		}
		function doMinify() {
			void transform(null);
		}
		async function doRepair() {
			const text = getText();
			if (text.trim() === '') return;
			try {
				const { jsonrepair } = await import('jsonrepair');
				const repaired = jsonrepair(text);
				// Pretty-print the repaired result for a clean payoff.
				setText(JSON.stringify(JSON.parse(repaired), null, spaceArg()));
			} catch {
				flashInvalid();
			}
		}
		async function doCopy() {
			if (await copyToClipboard(getText())) {
				setStatus('ok', 'Copied to clipboard');
				setTimeout(refreshStatus, 1200);
			} else {
				setStatus('error', 'Clipboard unavailable');
			}
		}
		function doDownload() {
			const blob = new Blob([getText()], { type: 'application/json' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = 'data.json';
			a.click();
			URL.revokeObjectURL(url);
		}
		// The variant's headline action, fired by Ctrl/Cmd+S.
		function runPrimary() {
			switch (variant) {
				case 'minify': void doMinify(); break;
				case 'repair': void doRepair(); break;
				case 'validate': refreshStatus(); break;
				default: void doFormat();
			}
		}

		// ── Theme toggle — shared island core (lib/island-theme). `onApply`
		// reconfigures the CodeMirror theme compartment so the live editor
		// surface matches the chosen mode. ──────────────────────────────────
		const themeBtn = root.querySelector<HTMLButtonElement>('[data-action="theme"]');
		const themeCtl = initThemeToggle({
			root: editorEl,
			button: themeBtn,
			onApply: (m) => view.dispatch({ effects: themeComp.reconfigure(themeExtensions(m)) }),
		});

		const actions: Record<string, () => void | Promise<void>> = {
			format: doFormat,
			minify: doMinify,
			repair: doRepair,
			validate: refreshStatus,
			copy: doCopy,
			download: doDownload,
			clear: () => { setText(''); view.focus(); },
			sample: () => setText(MESSY_DOC),
			theme: () => themeCtl.toggle(),
		};

		root.querySelectorAll('[data-action]').forEach((btn) => {
			const action = btn.getAttribute('data-action');
			if (!action) return;
			btn.addEventListener('click', () => {
				const fn = actions[action];
				if (fn) fn();
			});
		});

		const indentSel = root.querySelector<HTMLSelectElement>('#jb-indent');
		if (indentSel) {
			indentSel.addEventListener('change', (e) => {
				indentKey = (e.target as HTMLSelectElement).value;
				view.dispatch({ effects: indentComp.reconfigure(indentUnit.of(indentStrings[indentKey])) });
				// Re-format if the document is currently valid.
				if (checkJson(getText()).ok && getText().trim() !== '') doFormat();
			});
		}

		refreshStatus();
	}
</script>
