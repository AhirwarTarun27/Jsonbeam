---
/**
 * BaseHead — every <head> tag for SEO: title, description, canonical,
 * Open Graph, Twitter card, and JSON-LD structured data.
 */
import { SITE_NAME, SITE_DESCRIPTION, DEFAULT_OG_IMAGE, DEFAULT_OG_IMAGE_ALT } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: string;
	/** Alt text for the social card image (accessibility + richer previews). */
	imageAlt?: string;
	/** Plain objects serialised into <script type="application/ld+json">. */
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	imageAlt = DEFAULT_OG_IMAGE_ALT,
	jsonLd = [],
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
// Social platforms (Facebook, LinkedIn, X, Slack, Discord) only render raster
// OG images; our cards are 1200×630 PNGs. Declare type + dimensions so crawlers
// don't have to fetch the bytes to know the aspect ratio.
const ogImageType = ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg';

// Escape "</script>" sequences so structured data can't break out of the tag.
const serialize = (data: Record<string, unknown>) =>
	JSON.stringify(data).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Google Analytics (gtag.js). is:inline keeps Astro from bundling/processing
     these — they must ship verbatim. Loads a third-party script from Google;
     it measures page views only and never touches user JSON. -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Y4L94RDJBB"></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	gtag('js', new Date());
	gtag('config', 'G-Y4L94RDJBB');
</script>

<!-- Google AdSense. is:inline ships it verbatim (no Astro bundling). Loads a
     third-party script from Google for ad serving; it never touches user JSON,
     which is processed entirely client-side and never uploaded. -->
<script
	is:inline
	async
	src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6296837849054919"
	crossorigin="anonymous"></script>

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="sitemap" href="/sitemap.xml" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Theme -->
<meta name="theme-color" content="#ffffff" />

{
	jsonLd.map((data) => (
		<script is:inline type="application/ld+json" set:html={serialize(data)} />
	))
}
