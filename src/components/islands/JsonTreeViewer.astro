---
// Surface + syntax tokens for the workbench. Imported per-island (not from
// global.css) so content routes never ship them. See styles/workbench.css.
import '../../styles/workbench.css';
import '../../styles/workbench/tree.css';
import '../../styles/components/controls.css';
import PrivacyNote from '../ui/PrivacyNote.astro';
import '../../styles/components/kbd.css';
/**
 * The /json-tree-viewer island — a keyboard-first JSON tree explorer.
 *
 * This is the deliberately DISTINCT sibling of `JsonViewer.astro`. The viewer is
 * mouse-driven (click to expand, click a key to copy). The *tree* viewer is built
 * around the WAI-ARIA Tree View keyboard pattern: a single roving tab stop, and
 * ↑ ↓ → ← / Home / End / Enter / type-ahead to fly through deeply nested data
 * without touching the mouse. Its signature element is a live **path breadcrumb**
 * that always reflects the focused node — so the path you want is read off the
 * top of the pane, not hunted for.
 *
 * Framework-free (HTML + one typed client module). Large-file safe: children are
 * materialised lazily on first expand, and any single sibling render is windowed.
 * All processing is local — nothing is uploaded. In-app controls use the shared
 * 6px `.jb-btn` scale (global.css).
 */
const sample = `{
  "name": "JSON Beam",
  "private": true,
  "version": 2,
  "modes": ["text", "tree", "table", "graph"],
  "limits": { "maxFileSizeMB": 100, "workers": 4 },
  "users": [
    { "id": 1, "name": "Ada", "admin": true },
    { "id": 2, "name": "Linus", "admin": false }
  ],
  "tags": null
}`;
---

<div
	id="jb-tree-viewer"
	class="overflow-hidden rounded-md border border-hairline bg-canvas shadow-e3"
>
	<!-- Toolbar -->
	<div data-jb-toolbar class="flex flex-wrap items-center gap-1.5 border-b border-hairline bg-canvas-soft px-3 py-2">
		<button type="button" data-action="expand" class="jb-btn" title="Expand every node">Expand all</button>
		<button type="button" data-action="collapse" class="jb-btn" title="Collapse every node">Collapse all</button>

		<span class="mx-1 hidden h-5 w-px bg-hairline sm:block" aria-hidden="true"></span>

		<div class="ml-auto flex items-center gap-1.5">
			<button
				type="button"
				data-action="theme"
				class="jb-btn jb-btn-icon"
				aria-label="Switch to light theme"
				title="Toggle dark / light"
			><span data-theme-icon aria-hidden="true"></span></button>
			<button type="button" data-action="sample" class="jb-btn" title="Load a sample document">Sample</button>
			<button type="button" data-action="copy" class="jb-btn" title="Copy formatted JSON">Copy JSON</button>
			<button type="button" data-action="clear" class="jb-btn" title="Clear the input">Clear</button>
				<span class="mx-0.5 hidden h-5 w-px bg-hairline sm:block" aria-hidden="true"></span>
				<button type="button" data-jb-expand class="jb-btn jb-expand-btn" aria-pressed="false" title="Expand to full screen">
					<span class="jb-expand-ico" aria-hidden="true"></span>
					<span class="jb-expand-label">Full screen</span>
				</button>
		</div>
	</div>

	<!-- Path breadcrumb — the signature element: tracks the focused node. -->
	<div class="flex flex-wrap items-center gap-x-2 gap-y-1 border-b border-hairline bg-canvas-soft px-3 py-1.5">
		<span class="select-none font-mono text-caption uppercase tracking-wide text-mute">Path</span>
		<code data-path-display class="font-mono text-code text-body" title="Focused node path">$</code>
		<span data-path-meta class="font-mono text-caption text-mute"></span>
		<button
			type="button"
			data-action="copy-path"
			class="jb-btn jb-btn-icon ml-auto"
			aria-label="Copy focused node path"
			title="Copy focused path"
		>
			<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<rect x="5.5" y="5.5" width="8" height="8" rx="1.4" stroke="currentColor" stroke-width="1.3"></rect>
				<path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" stroke="currentColor" stroke-width="1.3"></path>
			</svg>
		</button>
	</div>

	<!-- Split: input + keyboard tree -->
	<div data-jb-split class="grid grid-cols-1 lg:grid-cols-2">
		<div class="border-b border-hairline lg:border-b-0 lg:border-r">
			<label class="sr-only" for="jb-kinput">JSON input</label>
			<textarea
				id="jb-kinput"
				spellcheck="false"
				autocomplete="off"
				autocapitalize="off"
				aria-label="JSON input"
				class="jb-pane-input w-full"
			>{sample}</textarea>
		</div>
		<div
			id="jb-ktree"
			data-jb-tree
			role="tree"
			aria-label="JSON tree — use arrow keys to navigate"
			class="jb-pane-output overflow-auto"
		></div>
	</div>

	<!-- Status bar -->
	<div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-hairline bg-canvas-soft px-3 py-2 text-body-sm">
		<span id="jb-kstatus" class="inline-flex items-center gap-1.5 font-medium" role="status" aria-live="polite">
			<span class="h-2 w-2 rounded-full bg-mute" data-dot></span>
			<span data-label>Ready</span>
		</span>
		<span data-stats class="font-mono text-caption text-mute">0 chars</span>
		<span class="hidden items-center gap-1 font-mono text-caption text-mute sm:inline-flex" data-jb-hints aria-hidden="true">
			<kbd class="jb-kbd">↑</kbd><kbd class="jb-kbd">↓</kbd><kbd class="jb-kbd">→</kbd><kbd class="jb-kbd">←</kbd>
			to navigate
		</span>
		<PrivacyNote />
	</div>
</div>

<style>
	/* The tree pane's surface, rows, carets, syntax palette and keyboard-focus
	   states all come from the shared `styles/workbench/tree.css` (scoped on
	   [data-jb-tree]). Only this island's own spacing + its kbd chip are here. */
	#jb-ktree {
		padding: 8px 10px;
	}
	/* Rows are individually roundable here because they carry a keyboard cursor. */
	:global(#jb-ktree .jb-row) {
		padding: 1px 4px;
		border-radius: var(--radius-xs);
	}


	/* Coarse pointers: roomier rows to go with the bigger carets. */
	@media (pointer: coarse) {
		:global(#jb-ktree .jb-row) {
			padding: 3px 4px;
		}
	}
</style>

<script>
	import { checkJson } from '../../lib/json/parse';
	import { loadDoc, saveDoc } from '../../lib/doc-store';
	import { initThemeToggle } from '../../lib/workbench/theme';
	import { initFullscreen } from '../../lib/workbench/fullscreen';
	import { copyToClipboard } from '../../lib/workbench/clipboard';
	import { attachHighlight } from '../../lib/workbench/highlight';
	import { createStatusBar } from '../../lib/workbench/status-bar';
	import { bindActions } from '../../lib/workbench/toolbar';
	import { debounce } from '../../lib/workbench/timing';
	import { createJsonTree, topSummary, type JsonValue } from '../../lib/workbench/json-tree';

	const root = document.getElementById('jb-tree-viewer');
	const inputEl = document.getElementById('jb-kinput') as HTMLTextAreaElement | null;
	const treeEl = document.getElementById('jb-ktree');

	if (root && inputEl && treeEl) {
		const input = inputEl;

		// Captured once so the Sample button can restore the starting document.
		const SAMPLE = input.value;

		// "Paste once" carry: rehydrate the document the user already has going this
		// session (from another tool) before the first render. A fresh visitor with
		// nothing carried keeps the sample, so the page still demos itself.
		const carried = loadDoc();
		if (carried !== null) input.value = carried;

		// Syntax-highlight the input JSON (shared overlay — matches the formatter).
		const hl = attachHighlight(input);

		// Status bar + stats readout (lib/workbench/status-bar).
		const statusBar = createStatusBar(root, { refresh: () => refreshStatus() });
		const setStatus = statusBar.set;
		const flashStatus = statusBar.flash;

		async function copyPath(path: string): Promise<void> {
			if (!path) return;
			if (await copyToClipboard(path)) flashStatus('ok', `Copied path: ${path}`);
			else flashStatus('error', 'Clipboard unavailable');
		}

		// The tree widget itself (lib/workbench/json-tree) — renderer, expand/
		// collapse, roving focus and the ARIA keyboard pattern, shared with
		// /json-viewer. This island adds the breadcrumb readout, so it hands the
		// module the two elements to keep in sync.
		const tree = createJsonTree({
			tree: treeEl,
			onCopyPath: (path) => void copyPath(path),
			pathDisplay: root.querySelector<HTMLElement>('[data-path-display]'),
			pathMeta: root.querySelector<HTMLElement>('[data-path-meta]'),
		});

		function setStats(chars: number, summary: string | null): void {
			const parts = [`${chars.toLocaleString()} chars`];
			if (summary) parts.unshift(summary);
			statusBar.stats(parts.join(' · '));
		}

		function refreshStatus(): void {
			const text = input.value;
			if (text.trim() === '') {
				setStatus('idle', 'Empty');
				setStats(text.length, null);
				return;
			}
			const res = checkJson(text);
			if (!res.ok) {
				setStatus('error', res.message);
				setStats(text.length, null);
				return;
			}
			setStatus('ok', 'Valid JSON');
			try {
				setStats(text.length, topSummary(JSON.parse(text) as JsonValue));
			} catch {
				setStats(text.length, null);
			}
		}

		// ── Parse + render ────────────────────────────────────────────────────────
		function update(): void {
			const text = input.value;
			if (text.trim() === '') {
				setStatus('idle', 'Empty');
				setStats(text.length, null);
				tree.placeholder('Paste JSON in the editor to explore it as a tree.');
				return;
			}
			const res = checkJson(text);
			if (!res.ok) {
				setStatus('error', res.message);
				setStats(text.length, null);
				tree.placeholder('Fix the JSON errors to see the tree.');
				return;
			}
			let parsed: JsonValue;
			try {
				parsed = JSON.parse(text) as JsonValue;
			} catch {
				setStatus('error', 'Invalid JSON');
				tree.placeholder('Fix the JSON errors to see the tree.');
				return;
			}
			setStatus('ok', 'Valid JSON');
			setStats(text.length, topSummary(parsed));
			tree.render(parsed);
		}

		function applyInput(): void {
			hl.refresh();
			update();
			saveDoc(input.value);
		}

		// ── Actions ────────────────────────────────────────────────────────────────
		async function copyJson(): Promise<void> {
			let out = input.value;
			const res = checkJson(out);
			if (res.ok) {
				try {
					out = JSON.stringify(JSON.parse(input.value), null, 2);
				} catch {
					/* keep raw */
				}
			}
			if (await copyToClipboard(out)) flashStatus('ok', 'Copied JSON');
			else flashStatus('error', 'Clipboard unavailable');
		}

		// ── Theme toggle — shared across every tool island (lib/island-theme). ───
		const themeCtl = initThemeToggle({ root });
		initFullscreen({
			root,
			toolName: 'Tree',
			onChange: () => window.dispatchEvent(new Event('resize')),
		});

		bindActions(root, {
			expand: () => tree.expandAll(),
			collapse: () => tree.collapseAll(),
			theme: () => themeCtl.toggle(),
			'copy-path': () => void copyPath(tree.currentPath()),
			sample: () => {
				input.value = SAMPLE;
				applyInput();
			},
			copy: copyJson,
			clear: () => {
				input.value = '';
				applyInput();
				input.focus();
			},
		});

		input.addEventListener('input', debounce(applyInput));

		update();
	}
</script>
