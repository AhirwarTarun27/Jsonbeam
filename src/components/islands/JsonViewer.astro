---
/**
 * The /json-viewer island — an interactive, collapsible JSON tree explorer.
 * Framework-free: HTML + one typed client module that parses the textarea and
 * renders a tree. Deliberately NOT built on CodeMirror — a viewer's job is
 * viewing, so a lightweight textarea + a hand-rolled tree keeps the page tiny.
 *
 * Large-file safe: a node's children are built lazily, only when it is first
 * expanded, so a huge document never materialises millions of DOM nodes up
 * front. All processing is local — nothing is uploaded. In-app controls use the
 * shared 6px `.jb-btn` scale (global.css).
 */
const sample = `{
  "name": "JSON Beam",
  "private": true,
  "version": 2,
  "modes": ["text", "tree", "table", "graph"],
  "limits": { "maxFileSizeMB": 100, "workers": 4 },
  "users": [
    { "id": 1, "name": "Ada", "admin": true },
    { "id": 2, "name": "Linus", "admin": false }
  ],
  "tags": null
}`;
---

<div
	id="jb-viewer"
	class="overflow-hidden rounded-md border border-hairline bg-canvas shadow-e3"
>
	<!-- Toolbar -->
	<div data-jb-toolbar class="flex flex-wrap items-center gap-1.5 border-b border-hairline bg-canvas-soft px-3 py-2">
		<button type="button" data-action="expand" class="jb-btn" title="Expand every node">Expand all</button>
		<button type="button" data-action="collapse" class="jb-btn" title="Collapse every node">Collapse all</button>

		<span class="mx-1 hidden h-5 w-px bg-hairline sm:block" aria-hidden="true"></span>

		<div class="ml-auto flex items-center gap-1.5">
			<button
				type="button"
				data-action="theme"
				class="jb-btn jb-btn-icon"
				aria-label="Switch to light theme"
				title="Toggle dark / light"
			><span data-theme-icon aria-hidden="true"></span></button>
			<button type="button" data-action="sample" class="jb-btn" title="Load a sample document">Sample</button>
			<button type="button" data-action="copy" class="jb-btn" title="Copy formatted JSON">Copy JSON</button>
			<button type="button" data-action="clear" class="jb-btn" title="Clear the input">Clear</button>
				<span class="mx-0.5 hidden h-5 w-px bg-hairline sm:block" aria-hidden="true"></span>
				<button type="button" data-jb-expand class="jb-btn jb-expand-btn" aria-pressed="false" title="Expand to full screen">
					<span class="jb-expand-ico" aria-hidden="true"></span>
					<span class="jb-expand-label">Full screen</span>
				</button>
		</div>
	</div>

	<!-- Split: input + tree -->
	<div data-jb-split class="grid grid-cols-1 lg:grid-cols-2">
		<div class="border-b border-hairline lg:border-b-0 lg:border-r">
			<label class="sr-only" for="jb-input">JSON input</label>
			<textarea
				id="jb-input"
				spellcheck="false"
				autocomplete="off"
				autocapitalize="off"
				aria-label="JSON input"
				class="h-[40vh] min-h-[240px] w-full lg:h-[74vh]"
			>{sample}</textarea>
		</div>
		<div
			id="jb-tree"
			role="tree"
			aria-label="JSON tree"
			class="h-[54vh] min-h-[320px] overflow-auto lg:h-[74vh]"
		></div>
	</div>

	<!-- Status bar -->
	<div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-hairline bg-canvas-soft px-3 py-2 text-body-sm">
		<span id="jb-status" class="inline-flex items-center gap-1.5 font-medium" role="status" aria-live="polite">
			<span class="h-2 w-2 rounded-full bg-mute" data-dot></span>
			<span data-label>Ready</span>
		</span>
		<span data-stats class="font-mono text-caption text-mute">0 chars</span>
		<span class="ml-auto inline-flex items-center gap-1.5 text-caption text-mute">
			<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M8 1.5 3 3.5v3.2c0 3 2.1 5.8 5 6.8 2.9-1 5-3.8 5-6.8V3.5L8 1.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
			</svg>
			Processed locally — nothing uploaded
		</span>
	</div>
</div>

<style>
	/* The input pane's surface + syntax highlighting come from the shared
	   `.jb-hl*` overlay (global.css); the tree pane is styled below. */
	#jb-tree {
		background-color: var(--color-editor-bg);
		color: var(--color-editor-fg);
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.7;
		padding: 12px 14px;
	}

	/* Selection stays readable on the dark surface (site default is an ink block). */
	:global(#jb-tree ::selection) {
		color: var(--color-on-primary);
		background-color: var(--color-editor-sel-dark);
	}

	/* ── Tree rows ─────────────────────────────────────────────────────────── */
	:global(#jb-tree .jb-row) {
		display: flex;
		align-items: flex-start;
		gap: 4px;
		white-space: pre;
		padding: 1px 0;
	}
	:global(#jb-tree .jb-children) {
		margin-left: 7px;
		padding-left: 14px;
		border-left: 1px solid rgba(255, 255, 255, 0.08);
	}

	/* Caret / leaf spacer — fixed width so keys align across rows. */
	:global(#jb-tree .jb-toggle) {
		flex: 0 0 auto;
		width: 16px;
		height: 20px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: none;
		background: none;
		color: var(--color-hairline-strong);
		cursor: pointer;
	}
	:global(#jb-tree .jb-toggle--leaf) {
		cursor: default;
	}
	:global(#jb-tree .jb-toggle svg) {
		transition: transform 0.12s ease;
	}
	:global(#jb-tree [role='treeitem'][aria-expanded='true'] > .jb-row > .jb-toggle svg) {
		transform: rotate(90deg);
	}

	/* Tokens — reuse the dark syntax palette from the editor. */
	:global(#jb-tree .jb-key) {
		color: var(--color-editor-fg);
		font-weight: 500;
		cursor: pointer;
	}
	:global(#jb-tree .jb-key:hover) {
		text-decoration: underline;
	}
	:global(#jb-tree .jb-punct),
	:global(#jb-tree .jb-summary) {
		color: var(--color-hairline-strong);
	}
	:global(#jb-tree .jb-summary) {
		cursor: pointer;
	}
	:global(#jb-tree .jb-string) {
		color: var(--color-cyan);
	}
	:global(#jb-tree .jb-number) {
		color: var(--color-violet-soft);
	}
	:global(#jb-tree .jb-bool),
	:global(#jb-tree .jb-null) {
		color: var(--color-warning);
	}
	:global(#jb-tree .jb-placeholder) {
		color: var(--color-mute);
		padding: 6px 2px;
		white-space: normal;
	}
	:global(#jb-tree .jb-more) {
		display: inline-block;
		margin: 4px 0 4px 16px;
		padding: 2px 10px;
		border-radius: var(--radius-sm);
		border: 1px solid rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.04);
		color: var(--color-editor-fg);
		font-family: var(--font-mono);
		font-size: 12px;
		cursor: pointer;
	}
	:global(#jb-tree .jb-more:hover) {
		background: rgba(255, 255, 255, 0.1);
	}

	/* ── Light theme — flip both panes to the canvas surface + light palette
	   (mirrors the formatter's light editor). Toggled by .jb-theme-light on the
	   #jb-viewer root. ──────────────────────────────────────────────────────── */
	:global(html.jb-theme-light #jb-viewer #jb-tree) {
		background-color: var(--color-canvas);
		color: var(--color-ink);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree ::selection) {
		color: var(--color-ink);
		background-color: var(--color-editor-sel-light);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-children) {
		border-left-color: var(--color-hairline);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-toggle) {
		color: var(--color-mute);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-key) {
		color: var(--color-ink);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-punct),
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-summary) {
		color: var(--color-mute);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-string) {
		color: var(--color-link-deep);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-number) {
		color: var(--color-violet);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-bool),
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-null) {
		color: var(--color-cyan-deep);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-more) {
		border-color: var(--color-hairline);
		background: var(--color-canvas-soft);
		color: var(--color-body);
	}
	:global(html.jb-theme-light #jb-viewer #jb-tree .jb-more:hover) {
		background: var(--color-canvas-soft-2);
	}

	/* Coarse pointers: bigger touch targets for the carets + roomier rows. */
	@media (pointer: coarse) {
		:global(#jb-tree .jb-toggle) {
			width: 28px;
			height: 28px;
		}
		:global(#jb-tree .jb-row) {
			padding: 3px 0;
		}
	}
</style>

<script>
	import { checkJson } from '../lib/json';
	import { loadDoc, saveDoc } from '../lib/doc-store';
	import { initThemeToggle } from '../lib/island-theme';
	import { initFullscreen } from '../lib/island-fullscreen';
	import { copyToClipboard } from '../lib/island-clipboard';
	import { attachHighlight } from '../lib/island-highlight';

	const root = document.getElementById('jb-viewer');
	const inputEl = document.getElementById('jb-input') as HTMLTextAreaElement | null;
	const treeEl = document.getElementById('jb-tree');

	if (root && inputEl && treeEl) {
		const input = inputEl;
		const tree = treeEl;

		type JsonValue = string | number | boolean | null | JsonValue[] | { [key: string]: JsonValue };
		type JsonObject = { [key: string]: JsonValue };

		// Captured once so the Sample button can restore the starting document.
		const SAMPLE = input.value;

		// "Paste once" carry: rehydrate the document the user already has going this
		// session (from another tool) before the first render. A fresh visitor with
		// nothing carried keeps the sample above, so the page still demos itself.
		const carried = loadDoc();
		if (carried !== null) input.value = carried;

		// Syntax-highlight the input JSON (shared overlay — matches the formatter).
		const hl = attachHighlight(input);

		const dot = root.querySelector<HTMLElement>('[data-dot]');
		const label = root.querySelector<HTMLElement>('[data-label]');
		const statsEl = root.querySelector<HTMLElement>('[data-stats]');

		// Per-container build closures — children are materialised lazily on first
		// expand (the large-file safety valve).
		const builders = new WeakMap<HTMLElement, () => void>();

		// Build the caret SVG once and clone it per node — re-parsing innerHTML for
		// every row is a real cost when a document has thousands of nodes.
		const chevronHost = document.createElement('span');
		chevronHost.innerHTML =
			'<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
		const CHEVRON_NODE = chevronHost.firstElementChild;

		// Auto-expand the first level only when the root is small enough that doing
		// so won't materialise a huge subtree (keeps the lazy strategy honest).
		const AUTO_EXPAND_MAX = 100;

		// Never build more than this many sibling rows in one synchronous pass — wide
		// arrays/objects render the first chunk and a "Show more" control for the rest,
		// so a single render can't freeze the tab regardless of breadth.
		const CHUNK = 1000;

		const IDENT = /^[A-Za-z_$][\w$]*$/;

		function isObject(v: JsonValue): v is JsonObject {
			return typeof v === 'object' && v !== null && !Array.isArray(v);
		}
		function isArray(v: JsonValue): v is JsonValue[] {
			return Array.isArray(v);
		}

		function childPath(parent: string, key: string | number): string {
			if (typeof key === 'number') return `${parent}[${key}]`;
			return IDENT.test(key) ? `${parent}.${key}` : `${parent}[${JSON.stringify(key)}]`;
		}

		function entriesOf(value: JsonObject | JsonValue[]): [string | number, JsonValue][] {
			return isArray(value)
				? value.map((v, i) => [i, v] as [number, JsonValue])
				: Object.entries(value);
		}

		function punct(text: string): HTMLElement {
			const span = document.createElement('span');
			span.className = 'jb-punct';
			span.textContent = text;
			return span;
		}

		function keySpan(key: string | number, path: string): HTMLElement {
			const span = document.createElement('span');
			span.className = 'jb-key';
			span.textContent = typeof key === 'number' ? String(key) : key;
			span.setAttribute('data-copy-path', '');
			span.setAttribute('data-path', path);
			span.setAttribute('title', `Copy path: ${path}`);
			return span;
		}

		function valueSpan(value: string | number | boolean | null): HTMLElement {
			const span = document.createElement('span');
			span.className = 'jb-val';
			if (typeof value === 'string') span.classList.add('jb-string');
			else if (typeof value === 'number') span.classList.add('jb-number');
			else if (typeof value === 'boolean') span.classList.add('jb-bool');
			else span.classList.add('jb-null');
			span.textContent = JSON.stringify(value);
			return span;
		}

		function summarySpan(value: JsonObject | JsonValue[]): HTMLElement {
			const span = document.createElement('span');
			span.className = 'jb-summary';
			span.setAttribute('data-toggle', '');
			if (isArray(value)) {
				const n = value.length;
				span.textContent = n === 0 ? '[ ]' : `[ ${n} ${n === 1 ? 'item' : 'items'} ]`;
			} else {
				const n = Object.keys(value).length;
				span.textContent = n === 0 ? '{ }' : `{ ${n} ${n === 1 ? 'key' : 'keys'} }`;
			}
			return span;
		}

		// Render entries [start, start+CHUNK) into a container; if more remain, add a
		// "Show more" button that renders the next chunk on demand.
		function appendChildren(
			container: HTMLElement,
			entries: [string | number, JsonValue][],
			parentPath: string,
			start: number,
		): void {
			const end = Math.min(start + CHUNK, entries.length);
			const frag = document.createDocumentFragment();
			for (let i = start; i < end; i++) {
				const entry = entries[i];
				frag.appendChild(createItem(entry[0], entry[1], parentPath));
			}
			container.appendChild(frag);
			if (end < entries.length) {
				const remaining = entries.length - end;
				const more = document.createElement('button');
				more.type = 'button';
				more.className = 'jb-more';
				more.textContent = `Show ${Math.min(CHUNK, remaining)} more — ${remaining.toLocaleString()} left`;
				more.addEventListener('click', () => {
					more.remove();
					appendChildren(container, entries, parentPath, end);
				});
				container.appendChild(more);
			}
		}

		function createItem(key: string | number | null, value: JsonValue, parentPath: string): HTMLElement {
			const path = key === null ? parentPath : childPath(parentPath, key);
			const item = document.createElement('div');
			item.setAttribute('role', 'treeitem');
			const row = document.createElement('div');
			row.className = 'jb-row';

			if (isObject(value) || isArray(value)) {
				item.setAttribute('aria-expanded', 'false');
				const toggle = document.createElement('button');
				toggle.type = 'button';
				toggle.className = 'jb-toggle';
				toggle.setAttribute('data-toggle', '');
				toggle.setAttribute('aria-label', 'Expand');
				if (CHEVRON_NODE) toggle.appendChild(CHEVRON_NODE.cloneNode(true));
				row.appendChild(toggle);
				if (key !== null) {
					row.appendChild(keySpan(key, path));
					row.appendChild(punct(':'));
				}
				row.appendChild(summarySpan(value));

				const group = document.createElement('div');
				group.className = 'jb-children';
				group.setAttribute('role', 'group');
				group.hidden = true;

				item.appendChild(row);
				item.appendChild(group);

				const container = value;
				let built = false;
				builders.set(item, () => {
					if (built) return;
					built = true;
					appendChildren(group, entriesOf(container), path, 0);
				});
			} else {
				const leaf = document.createElement('span');
				leaf.className = 'jb-toggle jb-toggle--leaf';
				row.appendChild(leaf);
				if (key !== null) {
					row.appendChild(keySpan(key, path));
					row.appendChild(punct(':'));
				}
				row.appendChild(valueSpan(value));
				item.appendChild(row);
			}
			return item;
		}

		function toggleItem(item: HTMLElement, expand?: boolean): void {
			const group = item.querySelector<HTMLElement>(':scope > .jb-children');
			if (!group) return;
			const isExpanded = item.getAttribute('aria-expanded') === 'true';
			const next = expand === undefined ? !isExpanded : expand;
			if (next) builders.get(item)?.();
			group.hidden = !next;
			item.setAttribute('aria-expanded', String(next));
			const toggle = item.querySelector<HTMLElement>(':scope > .jb-row > .jb-toggle');
			toggle?.setAttribute('aria-label', next ? 'Collapse' : 'Expand');
		}

		function expandTopLevel(): void {
			tree
				.querySelectorAll<HTMLElement>(':scope > [role="treeitem"][aria-expanded="false"]')
				.forEach((item) => toggleItem(item, true));
		}

		function expandAll(): void {
			let guard = 0;
			while (guard < 100000) {
				const collapsed = tree.querySelectorAll<HTMLElement>('[role="treeitem"][aria-expanded="false"]');
				if (collapsed.length === 0) break;
				collapsed.forEach((item) => toggleItem(item, true));
				guard++;
			}
		}

		function collapseAll(): void {
			tree
				.querySelectorAll<HTMLElement>('[role="treeitem"][aria-expanded="true"]')
				.forEach((item) => toggleItem(item, false));
		}

		function showPlaceholder(message: string): void {
			tree.replaceChildren();
			const p = document.createElement('div');
			p.className = 'jb-placeholder';
			p.textContent = message;
			tree.appendChild(p);
		}

		function renderRoot(value: JsonValue): void {
			tree.replaceChildren();
			if (isObject(value) || isArray(value)) {
				const entries = entriesOf(value);
				if (entries.length === 0) {
					showPlaceholder(isArray(value) ? 'Empty array — [ ]' : 'Empty object — { }');
					return;
				}
				appendChildren(tree, entries, '$', 0);
				if (entries.length <= AUTO_EXPAND_MAX) expandTopLevel();
			} else {
				tree.appendChild(createItem(null, value, '$'));
			}
		}

		// ── Status bar ────────────────────────────────────────────────────────
		function setStatus(state: 'ok' | 'error' | 'idle', text: string): void {
			if (!dot || !label) return;
			const colors: Record<string, string> = {
				ok: 'var(--color-success)',
				error: 'var(--color-error)',
				idle: 'var(--color-mute)',
			};
			dot.style.backgroundColor = colors[state] ?? colors.idle;
			label.textContent = text;
			label.style.color = state === 'error' ? 'var(--color-error-deep)' : 'var(--color-ink)';
		}

		function topSummary(value: JsonValue): string {
			if (isArray(value)) {
				const n = value.length;
				return `${n} ${n === 1 ? 'item' : 'items'}`;
			}
			if (isObject(value)) {
				const n = Object.keys(value).length;
				return `${n} ${n === 1 ? 'key' : 'keys'}`;
			}
			return 'scalar';
		}

		function setStats(chars: number, summary: string | null): void {
			if (!statsEl) return;
			const parts = [`${chars.toLocaleString()} chars`];
			if (summary) parts.unshift(summary);
			statsEl.textContent = parts.join(' · ');
		}

		// Refresh only the status/stats from the current input (no re-render).
		function refreshStatus(): void {
			const text = input.value;
			if (text.trim() === '') {
				setStatus('idle', 'Empty');
				setStats(text.length, null);
				return;
			}
			const res = checkJson(text);
			if (!res.ok) {
				setStatus('error', res.message);
				setStats(text.length, null);
				return;
			}
			setStatus('ok', 'Valid JSON');
			try {
				setStats(text.length, topSummary(JSON.parse(text) as JsonValue));
			} catch {
				setStats(text.length, null);
			}
		}

		let flashTimer = 0;
		function flashStatus(state: 'ok' | 'error', text: string): void {
			setStatus(state, text);
			clearTimeout(flashTimer);
			flashTimer = window.setTimeout(refreshStatus, 1300);
		}

		// ── Parse + render ──────────────────────────────────────────────────────
		function update(): void {
			const text = input.value;
			if (text.trim() === '') {
				setStatus('idle', 'Empty');
				setStats(text.length, null);
				showPlaceholder('Paste JSON in the editor to explore it as a tree.');
				return;
			}
			const res = checkJson(text);
			if (!res.ok) {
				setStatus('error', res.message);
				setStats(text.length, null);
				showPlaceholder('Fix the JSON errors to see the tree.');
				return;
			}
			let parsed: JsonValue;
			try {
				parsed = JSON.parse(text) as JsonValue;
			} catch {
				setStatus('error', 'Invalid JSON');
				showPlaceholder('Fix the JSON errors to see the tree.');
				return;
			}
			setStatus('ok', 'Valid JSON');
			setStats(text.length, topSummary(parsed));
			renderRoot(parsed);
		}

		// Re-render, then carry the working doc to the next tool page. Used for every
		// user-driven change (typing, Sample, Clear) — never for the first-load seed,
		// so a fresh visitor's demo document doesn't follow them around.
		function applyInput(): void {
			hl.refresh();
			update();
			saveDoc(input.value);
		}

		// ── Actions ──────────────────────────────────────────────────────────────
		async function copyJson(): Promise<void> {
			let out = input.value;
			const res = checkJson(out);
			if (res.ok) {
				try {
					out = JSON.stringify(JSON.parse(input.value), null, 2);
				} catch {
					/* keep raw */
				}
			}
			if (await copyToClipboard(out)) flashStatus('ok', 'Copied JSON');
			else flashStatus('error', 'Clipboard unavailable');
		}

		async function copyPath(path: string): Promise<void> {
			if (!path) return;
			if (await copyToClipboard(path)) flashStatus('ok', `Copied path: ${path}`);
			else flashStatus('error', 'Clipboard unavailable');
		}

		// ── Theme toggle — shared across every tool island (lib/island-theme). ───
		const themeCtl = initThemeToggle({ root });
		initFullscreen({
			root,
			toolName: 'Viewer',
			onChange: () => window.dispatchEvent(new Event('resize')),
		});

		const actions: Record<string, () => void | Promise<void>> = {
			expand: expandAll,
			collapse: collapseAll,
			theme: () => themeCtl.toggle(),
			sample: () => {
				input.value = SAMPLE;
				applyInput();
			},
			copy: copyJson,
			clear: () => {
				input.value = '';
				applyInput();
				input.focus();
			},
		};

		root.querySelectorAll('[data-action]').forEach((btn) => {
			const action = btn.getAttribute('data-action');
			if (!action) return;
			btn.addEventListener('click', () => {
				const fn = actions[action];
				if (fn) void fn();
			});
		});

		// One delegated listener for the whole tree: copy-path beats toggle.
		tree.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			const copyEl = target.closest<HTMLElement>('[data-copy-path]');
			if (copyEl) {
				void copyPath(copyEl.getAttribute('data-path') ?? '');
				return;
			}
			const toggleTarget = target.closest<HTMLElement>('[data-toggle]');
			if (!toggleTarget) return;
			const item = toggleTarget.closest<HTMLElement>('[role="treeitem"]');
			if (item) toggleItem(item);
		});

		let inputTimer = 0;
		input.addEventListener('input', () => {
			clearTimeout(inputTimer);
			inputTimer = window.setTimeout(applyInput, 300);
		});

		update();
	}
</script>
