---
/**
 * Reusable shell for prose / company / legal pages (About, Contact, Privacy,
 * Terms). Renders the SEO-critical chrome — hero with breadcrumb, a typeset
 * prose body via <slot/>, an optional visible FAQ that mirrors its FAQPage
 * structured data, and an internal-linking band back into the tools.
 *
 * These are content routes: 0 KB of app JS (only inline ld+json). No island,
 * no theme-boot script — they stay light, static, and indexable.
 *
 * Slotted prose is not reached by Astro's scoped-style hashing, so the prose
 * typography lives in a `<style is:global>` block scoped under `.jb-prose`
 * (same pattern as the homepage hero mockup).
 */
import Layout from '../layouts/Layout.astro';
import { SITE_URL } from '../consts';
import { webPage, faqPage, breadcrumbs, type FaqItem } from '../lib/jsonld';
import '../styles/prose.css';

interface Props {
	/** Route this page lives at, e.g. "/privacy". */
	slug: string;
	/** <title> (≤60 chars, keyword first). */
	title: string;
	/** <meta description> (≤155 chars). */
	description: string;
	/** Short label for the breadcrumb + structured data, e.g. "Privacy Policy". */
	breadcrumbLabel: string;
	/** Visible H1 (sentence case, period-terminated per DESIGN.md). */
	h1: string;
	/** Hero sub-paragraph. */
	intro: string;
	/** Human date string for legal pages, e.g. "June 22, 2026". */
	lastUpdated?: string;
	/** Narrows the schema.org class where a specific one exists. */
	schemaType?: 'WebPage' | 'AboutPage' | 'ContactPage';
	/** Optional visible FAQ — also emitted as FAQPage structured data. */
	faqs?: FaqItem[];
	faqTitle?: string;
	/** Keep utility pages (e.g. the contact thank-you screen) out of the index. */
	noindex?: boolean;
}

const {
	slug,
	title,
	description,
	breadcrumbLabel,
	h1,
	intro,
	lastUpdated,
	schemaType = 'WebPage',
	faqs = [],
	faqTitle = 'Frequently asked questions.',
	noindex = false,
} = Astro.props;

const pageUrl = `${SITE_URL}${slug}`;

const jsonLd = [
	webPage({ type: schemaType, name: `${breadcrumbLabel} — JSON Beam`, description, url: pageUrl }),
	breadcrumbs([
		{ name: 'Home', url: SITE_URL },
		{ name: breadcrumbLabel, url: pageUrl },
	]),
	...(faqs.length ? [faqPage(faqs)] : []),
];

// Internal-linking band — keeps every content page one hop from the tools.
const explore = [
	{ name: 'JSON Formatter', href: '/json-formatter', desc: 'Beautify, minify, validate & repair.' },
	{ name: 'JSON Validator', href: '/json-validator', desc: 'Pinpoint syntax errors instantly.' },
	{ name: 'JSON Viewer', href: '/json-viewer', desc: 'Explore JSON as a collapsible tree.' },
	{ name: 'JSON Diff', href: '/json-diff', desc: 'Compare two documents semantically.' },
];
---

<Layout title={title} description={description} jsonLd={jsonLd} noindex={noindex}>
	<!-- Hero -->
	<section class="border-b border-hairline bg-canvas-soft">
		<div class="container-page py-12">
			<nav aria-label="Breadcrumb" class="font-mono text-caption text-mute">
				<a href="/" class="hover:text-ink">Home</a>
				<span class="px-1.5">/</span>
				<span class="text-body">{breadcrumbLabel}</span>
			</nav>
			<h1 class="mt-4 max-w-3xl text-display-lg">{h1}</h1>
			<p class="mt-4 max-w-2xl text-body-lg text-body">{intro}</p>
			{
				lastUpdated && (
					<p class="mt-5 font-mono text-caption text-mute">Last updated: {lastUpdated}</p>
				)
			}
		</div>
	</section>

	<!-- Prose body -->
	<section class="bg-canvas">
		<div class="container-page py-16">
			<div class="jb-prose max-w-3xl text-body-md text-body">
				<slot />
			</div>
		</div>
	</section>

	<!-- Visible FAQ (mirrors FAQPage structured data) -->
	{
		faqs.length > 0 && (
			<section class="bg-canvas-soft">
				<div class="container-page grid gap-x-12 gap-y-8 py-20 lg:grid-cols-[1fr_1.7fr]">
					<div>
						<p class="font-mono text-caption uppercase tracking-wide text-mute">FAQ</p>
						<h2 class="mt-3 text-display-md">{faqTitle}</h2>
					</div>
					<div class="divide-y divide-hairline border-t border-hairline">
						{faqs.map((faq) => (
							<details class="group py-5">
								<summary class="flex cursor-pointer items-center justify-between gap-4 text-body-md font-medium text-ink marker:hidden [&::-webkit-details-marker]:hidden">
									{faq.question}
									<span
										class="text-mute transition-transform group-open:rotate-45"
										aria-hidden="true"
									>
										+
									</span>
								</summary>
								<p class="mt-3 text-body-md text-body">{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- Internal-linking band -->
	<section class="bg-canvas">
		<div class="container-page py-16">
			<h2 class="text-display-sm">Explore the JSON workbench.</h2>
			<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					explore.map((tool) => (
						<a
							href={tool.href}
							class="flex flex-col rounded-md bg-canvas-soft p-5 shadow-e1 transition-shadow hover:shadow-e3"
						>
							<h3 class="text-body-md font-medium text-ink">{tool.name}</h3>
							<p class="mt-1.5 text-body-sm text-body">{tool.desc}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Layout>
