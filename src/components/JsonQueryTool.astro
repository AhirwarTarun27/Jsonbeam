	transition: border-color 0.1s;
}
:global(.jb-qt-chip:hover) { border-color: var(--color-link); color: var(--color-link); }
/* ── Active tab within query tool ────────────────────────────────────────────── */
:global(#jb-qt [role="tab"][aria-selected="true"]) {
	background: var(--color-ink);
	color: var(--color-on-primary);
	border-color: var(--color-ink);
}
/* ── Snippet arrow animation ─────────────────────────────────────────────────── */
#jb-qt-snippets[open] #jb-qt-snip-arrow { transform: rotate(90deg); }
/* ── Light theme overrides ───────────────────────────────────────────────────── */
:global(#jb-qt.jb-theme-light #jb-qt-input) {
	background-color: var(--color-canvas);
	color: var(--color-ink);
}
:global(#jb-qt.jb-theme-light #jb-qt-result) {
	background-color: var(--color-canvas);
	color: var(--color-ink);
}
:global(#jb-qt.jb-theme-light #jb-qt-out .jb-q-s)  { color: var(--color-cyan-deep); }
:global(#jb-qt.jb-theme-light #jb-qt-out .jb-q-n)  { color: var(--color-violet); }
:global(#jb-qt.jb-theme-light #jb-qt-out .jb-q-b)  { color: var(--color-warning-deep); }
:global(#jb-qt.jb-theme-light #jb-qt-out .jb-q-nl) { color: var(--color-mute); }
:global(#jb-qt.jb-theme-light #jb-qt-out .jb-q-k)  { color: var(--color-ink); }
:global(#jb-qt.jb-theme-light #jb-qt-out .jb-q-p)  { color: var(--color-mute); }
:global(#jb-qt.jb-theme-light #jb-qt-out .jb-q-sep){ border-top-color: var(--color-hairline); }
/* ── Text selection in editor panes ─────────────────────────────────────────── */
/* Dark mode: desaturated-blue tint — visible on the dark editor surface */
:global(#jb-qt-input::selection) {
	background-color: var(--color-editor-sel-dark);
	color: var(--color-editor-fg);
}
:global(#jb-qt-out *::selection) {
	background-color: var(--color-editor-sel-dark);
	color: var(--color-editor-fg);
}
/* Light mode: soft blue tint — visible on the light canvas */
:global(#jb-qt.jb-theme-light #jb-qt-input::selection) {
	background-color: var(--color-editor-sel-light);
	color: var(--color-ink);
}
:global(#jb-qt.jb-theme-light #jb-qt-out *::selection) {
	background-color: var(--color-editor-sel-light);
	color: var(--color-ink);
}
</style>

<script>
import { loadDoc, saveDoc } from '../lib/doc-store';

const sample = `{
  "store": {
    "name": "Acme Books",
    "location": "San Francisco",
    "books": [
      { "id": 1, "title": "Clean Code",           "author": "Robert Martin",  "price": 34.99, "tags": ["programming", "best-practices"], "inStock": true  },
      { "id": 2, "title": "The Pragmatic Programmer", "author": "Andrew Hunt", "price": 44.95, "tags": ["programming", "career"],         "inStock": true  },
      { "id": 3, "title": "Design Patterns",       "author": "Gang of Four",  "price": 54.99, "tags": ["programming", "architecture"],    "inStock": false },
      { "id": 4, "title": "Refactoring",           "author": "Martin Fowler", "price": 39.99, "tags": ["programming", "best-practices"], "inStock": true  },
      { "id": 5, "title": "The Mythical Man-Month","author": "Fred Brooks",   "price": 28.50, "tags": ["management", "classic"],         "inStock": true  }
    ],
    "members": 1240,
    "rating": 4.7
  }
}`;

// ─── Types ────────────────────────────────────────────────────────────────────

type Lang = 'jsonpath' | 'jmespath' | 'jq';
type Mode = 'pretty' | 'raw' | 'count';

// ─── DOM refs ─────────────────────────────────────────────────────────────────

const rootEl        = document.getElementById('jb-qt');
const inputEl       = document.getElementById('jb-qt-input') as HTMLTextAreaElement | null;
const exprEl        = document.getElementById('jb-qt-expr') as HTMLInputElement | null;
const outEl         = document.getElementById('jb-qt-out');
const emptyEl       = document.getElementById('jb-qt-empty');
const errorEl       = document.getElementById('jb-qt-error');
const loadingEl     = document.getElementById('jb-qt-loading');
const countEl       = document.getElementById('jb-qt-count');
const evalMsEl      = document.getElementById('jb-qt-eval-ms');
const statusEl      = document.getElementById('jb-qt-status');
const inputStatusEl = document.getElementById('jb-qt-input-status');
const codeMenuEl    = document.getElementById('jb-qt-code-menu');
const historyEl     = document.getElementById('jb-qt-history');
const historyCEl    = document.getElementById('jb-qt-history-chips');
const themeIconEl   = document.querySelector<HTMLElement>('[data-theme-icon]');

if (!(
	rootEl && inputEl && exprEl && outEl && emptyEl && errorEl && loadingEl &&
	countEl && statusEl && inputStatusEl && codeMenuEl && historyEl && historyCEl
)) throw new Error('jb-qt: DOM not found');

// Non-null aliases for use in callbacks
const root       = rootEl;
const input      = inputEl;
const expr       = exprEl;
const out        = outEl;
const empty      = emptyEl;
const errorBox   = errorEl;
const loading    = loadingEl;
const count      = countEl;
const evalMs     = evalMsEl;
const status     = statusEl;
const inputStat  = inputStatusEl;
const codeMenu   = codeMenuEl;
const history    = historyEl;
const historyC   = historyCEl;

// ─── State ────────────────────────────────────────────────────────────────────

let lang: Lang = 'jsonpath';
let mode: Mode = 'pretty';
let lastResult: unknown[] = [];
let debounceTimer = 0;
const DEBOUNCE = 300;

// ─── History ─────────────────────────────────────────────────────────────────

const HIST_MAX = 5;

function histKey(l: Lang): string { return `jb-qhist-${l}`; }

function loadHistory(l: Lang): string[] {
	try { return JSON.parse(sessionStorage.getItem(histKey(l)) ?? '[]'); }
	catch { return []; }
}

function saveHistory(l: Lang, q: string) {
	if (!q.trim()) return;
	let h = loadHistory(l).filter(x => x !== q);
	h.unshift(q);
	h = h.slice(0, HIST_MAX);
	try { sessionStorage.setItem(histKey(l), JSON.stringify(h)); } catch { /* noop */ }
	renderHistory(l);
}

function renderHistory(l: Lang) {
	const h = loadHistory(l);
	historyC.replaceChildren();
	if (h.length === 0) { history.classList.add('hidden'); return; }
	history.classList.remove('hidden');
	for (const q of h) {
		const chip = document.createElement('button');
		chip.type = 'button';
		chip.className = 'jb-qt-chip';
		chip.textContent = q;
		chip.title = q;
		chip.addEventListener('click', () => { expr.value = q; runQuery(); });
		historyC.appendChild(chip);
	}
}

// ─── Theme ────────────────────────────────────────────────────────────────────

function paintTheme() {
	const light = localStorage.getItem('jb-theme') === 'light';
	root.classList.toggle('jb-theme-light', light);
	const icon = themeIconEl;
	if (icon) icon.textContent = light ? '☾' : '☀';
	const langBtn = document.querySelector<HTMLElement>('[data-action="theme"]');
	if (langBtn) langBtn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
}
paintTheme();
window.addEventListener('storage', e => { if (e.key === 'jb-theme') paintTheme(); });

// ─── Language switching ────────────────────────────────────────────────────────

function switchLang(newLang: Lang) {
	lang = newLang;
	// Update lang tab aria-selected
	document.querySelectorAll<HTMLElement>('[role="tab"][data-lang]').forEach(btn => {
		btn.setAttribute('aria-selected', btn.dataset['lang'] === lang ? 'true' : 'false');
	});
	// Update snippet panels
	document.querySelectorAll<HTMLElement>('[data-snip-panel]').forEach(el => {
		el.classList.toggle('hidden', el.dataset['snipPanel'] !== lang);
	});
	// Update snippet lang tabs
	document.querySelectorAll<HTMLElement>('[data-snip-lang][role="tab"]').forEach(btn => {
		btn.setAttribute('aria-selected', btn.dataset['snipLang'] === lang ? 'true' : 'false');
	});
	// Update placeholder
	const placeholders: Record<Lang, string> = {
		jsonpath: '$.store.books[*].title',
		jmespath: 'store.books[*].title',
		jq: '.store.books[].title',
	};
	expr.placeholder = placeholders[lang];
	renderHistory(lang);
	// Auto-run if there's an expression
	if (expr.value.trim()) scheduleQuery();
}

// ─── Mode switching ───────────────────────────────────────────────────────────

function switchMode(newMode: Mode) {
	mode = newMode;
	document.querySelectorAll<HTMLElement>('[data-action="mode"]').forEach(btn => {
		btn.setAttribute('aria-pressed', btn.dataset['mode'] === mode ? 'true' : 'false');
	});
	if (lastResult.length > 0) renderResult(lastResult, false);
}

// ─── Status helpers ───────────────────────────────────────────────────────────

function setStatus(label: string, color: 'mute' | 'ok' | 'err' | 'run') {
	const dot = status.querySelector<HTMLElement>('[data-dot]');
	const lbl = status.querySelector<HTMLElement>('[data-label]');
	if (dot) {
		dot.className = 'h-2 w-2 rounded-full';
		dot.classList.add(color === 'ok' ? 'bg-success' : color === 'err' ? 'bg-error' : color === 'run' ? 'bg-warning' : 'bg-mute');
	}
	if (lbl) lbl.textContent = label;
}

function setPanel(which: 'out' | 'empty' | 'error' | 'loading') {
	out.classList.toggle('hidden', which !== 'out');
	empty.classList.toggle('hidden', which !== 'empty');
	errorBox.classList.toggle('hidden', which !== 'error');
	loading.classList.toggle('hidden', which !== 'loading');
}

// ─── Syntax highlighting ─────────────────────────────────────────────────────

function highlight(v: unknown, indent = 0): DocumentFragment {
	const frag = document.createDocumentFragment();
	const sp = (cls: string, text: string) => {
		const s = document.createElement('span');
		s.className = cls;
		s.textContent = text;
		frag.appendChild(s);
		return s;
	};
	const txt = (t: string) => frag.appendChild(document.createTextNode(t));
	const pad = '  '.repeat(indent);

	if (v === null)          { sp('jb-q-nl', 'null'); return frag; }
	if (typeof v === 'boolean') { sp('jb-q-b', String(v)); return frag; }
	if (typeof v === 'number') { sp('jb-q-n', String(v)); return frag; }
	if (typeof v === 'string') { sp('jb-q-s', JSON.stringify(v)); return frag; }

	if (Array.isArray(v)) {
		sp('jb-q-p', '[');
		if (v.length === 0) { sp('jb-q-p', ']'); return frag; }
		txt('\n');
		v.forEach((item, i) => {
			txt(pad + '  ');
			frag.appendChild(highlight(item, indent + 1));
			if (i < v.length - 1) sp('jb-q-p', ',');
			txt('\n');
		});
		txt(pad); sp('jb-q-p', ']');
		return frag;
	}

	if (typeof v === 'object' && v !== null) {
		const obj = v as Record<string, unknown>;
		const keys = Object.keys(obj);
		sp('jb-q-p', '{');
		if (keys.length === 0) { sp('jb-q-p', '}'); return frag; }
		txt('\n');
		keys.forEach((k, i) => {
			txt(pad + '  ');
			sp('jb-q-k', JSON.stringify(k));
			sp('jb-q-p', ': ');
			frag.appendChild(highlight(obj[k], indent + 1));
			if (i < keys.length - 1) sp('jb-q-p', ',');
			txt('\n');
		});
		txt(pad); sp('jb-q-p', '}');
		return frag;
	}

	txt(String(v));
	return frag;
}

// ─── Result rendering ─────────────────────────────────────────────────────────

function renderResult(values: unknown[], truncated: boolean) {
	lastResult = values;
	if (values.length === 0) {
		count.textContent = 'no results';
		setPanel('empty');
		empty.querySelector('p')!.textContent = 'Query returned no results.';
		return;
	}

	count.textContent = `${values.length} value${values.length !== 1 ? 's' : ''}${truncated ? ' (truncated)' : ''}`;

	if (mode === 'count') {
		out.replaceChildren();
		const div = document.createElement('div');
		div.className = 'px-3 py-8 text-center';
		const n = document.createElement('span');
		n.className = 'font-mono text-display-lg jb-q-n';
		n.textContent = String(values.length);
		const lbl = document.createElement('p');
		lbl.className = 'mt-2 font-mono text-caption text-mute';
		lbl.textContent = `value${values.length !== 1 ? 's' : ''}`;
		div.appendChild(n);
		div.appendChild(lbl);
		out.appendChild(div);
		setPanel('out');
		return;
	}

	if (mode === 'raw') {
		out.replaceChildren();
		const pre = document.createElement('div');
		pre.style.whiteSpace = 'pre';
		values.forEach((v, i) => {
			if (i > 0) {
				const sep = document.createElement('span');
				sep.className = 'jb-q-sep';
				pre.appendChild(sep);
			}
			if (values.length > 1) {
				const idx = document.createElement('span');
				idx.className = 'jb-q-idx';
				idx.textContent = `[${i}] `;
				pre.appendChild(idx);
			}
			pre.appendChild(highlight(v));
			pre.appendChild(document.createTextNode('\n'));
		});
		out.appendChild(pre);
		setPanel('out');
		return;
	}

	// Pretty mode (default)
	out.replaceChildren();
	if (values.length === 1) {
		const pre = document.createElement('div');
		pre.style.whiteSpace = 'pre';
		pre.appendChild(highlight(values[0]));
		out.appendChild(pre);
	} else {
		const pre = document.createElement('div');
		pre.style.whiteSpace = 'pre';
		values.forEach((v, i) => {
			if (i > 0) {
				const sep = document.createElement('span');
				sep.className = 'jb-q-sep';
				pre.appendChild(sep);
			}
			const idx = document.createElement('span');
			idx.className = 'jb-q-idx';
			idx.textContent = `▸ [${i}]  `;
			pre.appendChild(idx);
			pre.appendChild(highlight(v));
			pre.appendChild(document.createTextNode('\n'));
		});
		out.appendChild(pre);
	}
	setPanel('out');
}

// ─── Input validation ─────────────────────────────────────────────────────────

function validateInput(): unknown | null {
	const raw = input.value.trim();
	if (!raw) { inputStat.textContent = ''; inputStat.className = 'ml-auto font-mono text-caption'; return null; }
	try {
		const parsed = JSON.parse(raw);
		inputStat.textContent = '✓ valid JSON';
		inputStat.className = 'ml-auto font-mono text-caption text-success';
		return parsed;
	} catch (e) {
		const msg = e instanceof Error ? e.message.replace(/^JSON.parse: /, '') : 'Invalid JSON';
		inputStat.textContent = '✗ ' + msg.slice(0, 50);
		inputStat.className = 'ml-auto font-mono text-caption text-error';
		return null;
	}
}

// ─── Engines (lazy-loaded) ────────────────────────────────────────────────────

type JSONPathLib = { JSONPath: (opts: { path: string; json: unknown; resultType?: string; wrap?: boolean }) => unknown };
type JMESPathLib = { search: (data: unknown, expr: string) => unknown };

let _jsonpathLib: JSONPathLib | null = null;
let _jmespathLib: JMESPathLib | null = null;

async function evalJSONPath(data: unknown, q: string): Promise<unknown[]> {
	if (!_jsonpathLib) {
		const m = await import('jsonpath-plus');
		_jsonpathLib = m as unknown as JSONPathLib;
	}
	const result = _jsonpathLib.JSONPath({ path: q, json: data, resultType: 'value', wrap: true });
	return Array.isArray(result) ? result as unknown[] : [result];
}

async function evalJMESPath(data: unknown, q: string): Promise<unknown[]> {
	if (!_jmespathLib) {
		const m = await import('jmespath');
		_jmespathLib = m as unknown as JMESPathLib;
	}
	const result = _jmespathLib.search(data, q);
	return [result];
}

async function evalJq(data: unknown, q: string): Promise<{ values: unknown[]; truncated: boolean }> {
	const { runJq } = await import('../lib/jq');
	const r = runJq(data, q);
	if (!r.ok) throw new Error(r.error);
	return { values: r.values, truncated: r.truncated };
}

// ─── Run query ────────────────────────────────────────────────────────────────

async function runQuery() {
	const data = validateInput();
	const q = expr.value.trim();

	if (!data || !q) {
		setPanel('empty');
		count.textContent = '';
		if (evalMs) evalMs.textContent = '';
		setStatus('Ready', 'mute');
		return;
	}

	setPanel('loading');
	setStatus('Evaluating…', 'run');

	try {
		const t0 = performance.now();
		let values: unknown[];
		let truncated = false;

		if (lang === 'jsonpath') {
			values = await evalJSONPath(data, q);
		} else if (lang === 'jmespath') {
			values = await evalJMESPath(data, q);
		} else {
			const r = await evalJq(data, q);
			values = r.values;
			truncated = r.truncated;
		}

		const ms = performance.now() - t0;
		if (evalMs) evalMs.textContent = `${ms.toFixed(1)} ms`;

		renderResult(values, truncated);
		setStatus(`${values.length} value${values.length !== 1 ? 's' : ''}`, 'ok');
		saveHistory(lang, q);
		saveDoc(input.value);

	} catch (e) {
		const msg = e instanceof Error ? e.message : String(e);
		const errMsg = errorBox.querySelector<HTMLElement>('[data-message]');
		const errHint = errorBox.querySelector<HTMLElement>('[data-hint]');
		if (errMsg) errMsg.textContent = msg;
		if (errHint) errHint.textContent = getErrorHint(lang, q, msg);
		setPanel('error');
		count.textContent = 'error';
		setStatus('Error', 'err');
	}
}

function getErrorHint(l: Lang, q: string, msg: string): string {
	if (l === 'jsonpath' && !q.startsWith('$')) return 'JSONPath expressions must start with $';
	if (l === 'jmespath' && q.startsWith('$')) return 'JMESPath does not use $ — try removing it';
	if (l === 'jq' && !q.startsWith('.') && !q.startsWith('[') && !q.startsWith('{') && !/^\d/.test(q) && !/^"/.test(q) && !['null','true','false'].some(kw => q.startsWith(kw))) return 'jq filters usually start with . (identity)';
	if (msg.includes('undefined function')) return 'Check the jq manual — this function name may be misspelled';
	if (msg.includes('cannot be')) return 'Type mismatch — check that your input has the expected structure';
	return '';
}

function scheduleQuery() {
	clearTimeout(debounceTimer);
	debounceTimer = window.setTimeout(runQuery, DEBOUNCE);
}

// ─── Copy as code ─────────────────────────────────────────────────────────────

function codeSnippet(target: string): string {
	const q = expr.value || '$.field';
	const escapedQ = q.replace(/`/g, '\\`');
	switch (target) {
		case 'js-jsonpath': return `import { JSONPath } from 'jsonpath-plus';\n\nconst result = JSONPath({\n  path: \`${escapedQ}\`,\n  json: data,\n  resultType: 'value',\n});\nconsole.log(result);`;
		case 'js-jmespath': return `import jmespath from 'jmespath';\n\nconst result = jmespath.search(data, \`${escapedQ}\`);\nconsole.log(result);`;
		case 'js-jq': return `import jq from 'jq-web';\n\nconst result = await jq.promised.json(data, \`${escapedQ}\`);\nconsole.log(result);`;
		case 'py-jsonpath': return `from jsonpath_ng import parse\n\nexpr = parse('${q.replace(/'/g,"\\'")}');\nresult = [match.value for match in expr.find(data)]\nprint(result)`;
		case 'py-jmespath': return `import jmespath\n\nresult = jmespath.search('${q.replace(/'/g,"\\'")}', data)\nprint(result)`;
		case 'cli-jq': return `echo '${JSON.stringify(JSON.parse(input.value.trim() || 'null'))}' | jq '${q.replace(/'/g, "'\\''")}'`;
		case 'go-gjson': return `import "github.com/tidwall/gjson"\n\nresult := gjson.Get(jsonStr, \`${escapedQ}\`)\nfmt.Println(result)`;
		default: return '';
	}
}

// ─── Init ────────────────────────────────────────────────────────────────────

function init() {
	// Load doc from store or use sample
	const stored = loadDoc();
	input.value = stored ?? sample;
	validateInput();

	// Render initial state
	renderHistory(lang);
	setPanel('empty');

	// Wire all button actions
	document.querySelectorAll<HTMLElement>('[data-action]').forEach(btn => {
		btn.addEventListener('click', async e => {
			const action = btn.dataset['action']!;
			switch (action) {
				case 'sample':
					input.value = sample;
					validateInput();
					scheduleQuery();
					break;
				case 'clear':
					input.value = '';
					expr.value = '';
					out.replaceChildren();
					setPanel('empty');
					count.textContent = '';
					setStatus('Ready', 'mute');
					inputStat.textContent = '';
					saveDoc('');
					break;
				case 'run':
					await runQuery();
					break;
				case 'mode':
					switchMode(btn.dataset['mode'] as Mode);
					break;
				case 'copy-result': {
					const text = lastResult.length === 1
						? JSON.stringify(lastResult[0], null, 2)
						: JSON.stringify(lastResult, null, 2);
					await navigator.clipboard.writeText(text);
					const orig = btn.textContent;
					btn.textContent = 'Copied!';
					setTimeout(() => { btn.textContent = orig; }, 1200);
					break;
				}
				case 'download-result': {
					const text = JSON.stringify(lastResult.length === 1 ? lastResult[0] : lastResult, null, 2);
					const blob = new Blob([text], { type: 'application/json' });
					const a = document.createElement('a');
					a.href = URL.createObjectURL(blob);
					a.download = 'query-result.json';
					a.click();
					URL.revokeObjectURL(a.href);
					break;
				}
				case 'copy-code': {
					e.stopPropagation();
					codeMenu.classList.toggle('hidden');
					break;
				}
				case 'theme': {
					const cur = localStorage.getItem('jb-theme');
					localStorage.setItem('jb-theme', cur === 'light' ? 'dark' : 'light');
					paintTheme();
					window.dispatchEvent(new StorageEvent('storage', { key: 'jb-theme' }));
					break;
				}
			}
		});
	});

	// Language tabs
	document.querySelectorAll<HTMLElement>('[role="tab"][data-lang]').forEach(btn => {
		btn.addEventListener('click', () => switchLang(btn.dataset['lang'] as Lang));
	});

	// Snippet panel sub-tabs
	document.querySelectorAll<HTMLElement>('[role="tab"][data-snip-lang]').forEach(btn => {
		btn.addEventListener('click', () => switchLang(btn.dataset['snipLang'] as Lang));
	});

	// Snippet cards
	document.querySelectorAll<HTMLElement>('[data-snip]').forEach(card => {
		card.addEventListener('click', () => {
			const snipLang = card.dataset['snipLang'] as Lang;
			const snip = card.dataset['snip']!;
			if (snipLang !== lang) switchLang(snipLang);
			expr.value = snip;
			runQuery();
		});
	});

	// Code menu items
	document.querySelectorAll<HTMLElement>('[data-lang-code]').forEach(item => {
		item.addEventListener('click', async () => {
			codeMenu.classList.add('hidden');
			const snippet = codeSnippet(item.dataset['langCode']!);
			await navigator.clipboard.writeText(snippet);
			const codeBtn = document.querySelector<HTMLElement>('[data-action="copy-code"]');
			if (codeBtn) {
				const orig = codeBtn.textContent;
				codeBtn.textContent = 'Copied!';
				setTimeout(() => { codeBtn.textContent = orig; }, 1400);
			}
		});
	});

	// Close code menu on outside click
	document.addEventListener('click', e => {
		const wrap = document.getElementById('jb-qt-code-wrap');
		if (wrap && !wrap.contains(e.target as Node)) codeMenu.classList.add('hidden');
	});

	// Input auto-save + validate
	input.addEventListener('input', () => {
		validateInput();
		saveDoc(input.value);
		scheduleQuery();
	});

	// Expression input — debounce
	expr.addEventListener('input', scheduleQuery);

	// Ctrl+Enter to run
	document.addEventListener('keydown', (e: KeyboardEvent) => {
		if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
			e.preventDefault();
			runQuery();
		}
	});

	// Keyboard: Tab to switch language
	expr.addEventListener('keydown', (e: KeyboardEvent) => {
		if (e.key === 'Tab' && !e.shiftKey) {
			e.preventDefault();
			const langs: Lang[] = ['jsonpath', 'jmespath', 'jq'];
			const next = langs[(langs.indexOf(lang) + 1) % langs.length]!;
			switchLang(next);
		}
	});
}

init();
</script>
