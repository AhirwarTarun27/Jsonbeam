---
// NOTE: sample JSON is defined in the <script> block below (not here) because
// Astro frontmatter is server-side only and cannot be referenced by client scripts.
/**
 * JSON Query Tool island — JSONPath, JMESPath, and jq in one surface.
 *
 * What puts this ahead of every competitor:
 *   • Three languages in one tool — JSONPath (RFC 9535), JMESPath, and jq —
 *     with a per-language snippet library. No competitor does all three.
 *   • Live evaluation: 300 ms debounce, result updates as you type.
 *   • Syntax-highlighted output with line counts and type annotations.
 *   • Copy as code — one click to get a runnable JS / Python / CLI snippet.
 *   • Query history: last 5 queries per language, shown as clickable chips.
 *   • Result modes: pretty JSON, raw, and count-only.
 *   • Multi-value output: jq / JSONPath can yield many values — each shown
 *     individually with its index.
 *   • "Download as JSON" for the full result array.
 *   • Theme toggle (dark/light) shared via localStorage (jb-theme key).
 *   • Doc-store carry: the current document follows from any other tool page.
 *
 * Language engines are lazy-loaded on first use — zero bundle cost until needed.
 * Framework-free: HTML + one typed client module. Nothing is ever uploaded.
 */
---

<div id="jb-qt" class="overflow-hidden rounded-md border border-hairline bg-canvas shadow-e3">

	<!-- Toolbar -->
	<div class="flex flex-wrap items-center gap-1.5 border-b border-hairline bg-canvas-soft px-3 py-2">
		<button type="button" data-action="sample" class="jb-btn">Sample</button>

		<span class="mx-1 hidden h-5 w-px bg-hairline sm:block" aria-hidden="true"></span>

		<!-- Result mode -->
		<div role="group" aria-label="Result mode" class="flex gap-0.5">
			<button type="button" data-mode="pretty" data-action="mode" aria-pressed="true"
				class="jb-btn" title="Pretty-print result JSON">Pretty</button>
			<button type="button" data-mode="raw" data-action="mode" aria-pressed="false"
				class="jb-btn" title="Raw JSON values (one per line)">Raw</button>
			<button type="button" data-mode="count" data-action="mode" aria-pressed="false"
				class="jb-btn" title="Show only count of results">Count</button>
		</div>

		<span class="mx-1 hidden h-5 w-px bg-hairline sm:block" aria-hidden="true"></span>

		<div class="ml-auto flex flex-wrap items-center gap-1.5">
			<div class="relative" id="jb-qt-code-wrap">
				<button type="button" data-action="copy-code" class="jb-btn" title="Copy as runnable code snippet">
					Code ↓
				</button>
				<div id="jb-qt-code-menu"
					class="absolute right-0 z-20 mt-1 hidden w-52 rounded-md border border-hairline bg-canvas py-1 shadow-e4"
					role="menu"
				>
					<button role="menuitem" data-lang-code="js-jsonpath" class="jb-code-opt">JavaScript · jsonpath-plus</button>
					<button role="menuitem" data-lang-code="js-jmespath" class="jb-code-opt">JavaScript · jmespath.js</button>
					<button role="menuitem" data-lang-code="js-jq"       class="jb-code-opt">JavaScript · jq-web</button>
					<button role="menuitem" data-lang-code="py-jsonpath"  class="jb-code-opt">Python · jsonpath-ng</button>
					<button role="menuitem" data-lang-code="py-jmespath"  class="jb-code-opt">Python · jmespath.py</button>
					<button role="menuitem" data-lang-code="cli-jq"       class="jb-code-opt">CLI · jq</button>
					<button role="menuitem" data-lang-code="go-gjson"     class="jb-code-opt">Go · tidwall/gjson</button>
				</div>
			</div>
			<button type="button" data-action="download-result" class="jb-btn" title="Download result as JSON">Result ↓</button>
			<button type="button" data-action="copy-result"  class="jb-btn" title="Copy result to clipboard">Copy result</button>
			<button
				type="button"
				data-action="theme"
				class="jb-btn jb-btn-icon"
				aria-label="Switch to light theme"
				title="Toggle dark / light"
			><span data-theme-icon aria-hidden="true"></span></button>
			<button type="button" data-action="clear" class="jb-btn" title="Clear input">Clear</button>
		</div>
	</div>

	<!-- Query bar -->
	<div class="flex flex-wrap items-center gap-2 border-b border-hairline bg-canvas-soft px-3 py-2">
		<!-- Language selector -->
		<div role="tablist" aria-label="Query language" class="flex gap-0.5">
			<button role="tab" data-lang="jsonpath" aria-selected="true"
				class="jb-tab" title="JSONPath (RFC 9535 / Goessner extended)">JSONPath</button>
			<button role="tab" data-lang="jmespath" aria-selected="false"
				class="jb-tab" title="JMESPath — AWS-style structured query">JMESPath</button>
			<button role="tab" data-lang="jq" aria-selected="false"
				class="jb-tab" title="jq — the Swiss army knife for JSON">jq</button>
		</div>

		<span class="hidden h-5 w-px bg-hairline sm:block" aria-hidden="true"></span>

		<!-- Expression input -->
		<div class="flex min-w-0 flex-1 items-center gap-1.5">
			<label class="sr-only" for="jb-qt-expr">Query expression</label>
			<input
				id="jb-qt-expr"
				type="text"
				spellcheck="false"
				autocomplete="off"
				placeholder="$.store.books[*].title"
				aria-label="Query expression"
				class="h-8 min-w-0 flex-1 rounded-sm border border-hairline bg-canvas px-3 font-mono text-code text-ink placeholder:text-mute outline-none focus:border-link focus:ring-1 focus:ring-link"
			/>
			<button type="button" data-action="run" class="jb-btn jb-btn-primary flex-shrink-0" title="Run query (Ctrl+Enter)">
				Run ▶
			</button>
		</div>
	</div>

	<!-- Query history chips -->
	<div id="jb-qt-history" class="hidden border-b border-hairline bg-canvas-soft px-3 py-1.5">
		<span class="mr-2 font-mono text-caption text-mute">Recent:</span>
		<div id="jb-qt-history-chips" class="inline-flex flex-wrap gap-1"></div>
	</div>

	<!-- Main two-pane content -->
	<div class="grid grid-cols-1 lg:grid-cols-2">
		<!-- Left: JSON input -->
		<div class="border-b border-hairline lg:border-b-0 lg:border-r">
			<div class="flex items-center gap-2 border-b border-hairline bg-canvas-soft px-3 py-1">
				<span class="font-mono text-caption uppercase tracking-wide text-mute">JSON input</span>
				<span id="jb-qt-input-status" class="ml-auto font-mono text-caption" aria-live="polite"></span>
			</div>
			<label class="sr-only" for="jb-qt-input">JSON input document</label>
			<textarea
				id="jb-qt-input"
				spellcheck="false"
				autocomplete="off"
				autocapitalize="off"
				aria-label="JSON input document"
				class="h-[62vh] min-h-[360px] w-full"
			></textarea>
		</div>

		<!-- Right: Result -->
		<div class="flex flex-col">
			<div class="flex items-center gap-2 border-b border-hairline bg-canvas-soft px-3 py-1">
				<span class="font-mono text-caption uppercase tracking-wide text-mute">Result</span>
				<span id="jb-qt-count" class="font-mono text-caption text-mute" aria-live="polite"></span>
				<span id="jb-qt-eval-ms" class="ml-auto font-mono text-caption text-mute"></span>
			</div>
			<div id="jb-qt-result" class="relative h-[62vh] min-h-[360px] overflow-auto" role="region" aria-label="Query result">
				<div id="jb-qt-out"     class="hidden px-3 py-3 font-mono text-code" aria-live="polite"></div>
				<div id="jb-qt-empty"   class="hidden flex-col items-center justify-center gap-2 px-6 py-12 text-center">
					<p class="font-mono text-caption text-mute">Enter a query above and press Run.</p>
				</div>
				<div id="jb-qt-error"   class="hidden px-3 py-3">
					<p class="font-mono text-caption font-medium text-error" data-message></p>
					<p class="mt-1 font-mono text-caption text-mute" data-hint></p>
				</div>
				<div id="jb-qt-loading" class="hidden items-center justify-center gap-2 px-3 py-8 text-center">
					<span class="font-mono text-caption text-mute">Evaluating…</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Snippet library — collapsible -->
	<details id="jb-qt-snippets" class="border-t border-hairline">
		<summary class="flex cursor-pointer items-center gap-2 bg-canvas-soft px-3 py-2 text-body-sm font-medium text-ink hover:bg-canvas-soft-2">
			<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-open:rotate-90" id="jb-qt-snip-arrow">
				<path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
			Snippet library
			<span class="ml-1 font-mono text-caption text-mute">— click any snippet to run it</span>
		</summary>
		<div class="bg-canvas px-3 py-4">
			<!-- Language sub-tabs inside snippets -->
			<div role="tablist" aria-label="Snippet language" class="mb-4 flex gap-0.5">
				<button role="tab" data-snip-lang="jsonpath" aria-selected="true" class="jb-tab">JSONPath</button>
				<button role="tab" data-snip-lang="jmespath" aria-selected="false" class="jb-tab">JMESPath</button>
				<button role="tab" data-snip-lang="jq" aria-selected="false" class="jb-tab">jq</button>
			</div>

			<!-- JSONPath snippets -->
			<div data-snip-panel="jsonpath">
				<div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
					<!-- Group: Basic access -->
					<div class="col-span-full font-mono text-caption uppercase tracking-wide text-mute">Basic access</div>
					<button data-snip="$.store.name" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.name</code>
						<span>Single field</span>
					</button>
					<button data-snip="$.store.books[0]" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[0]</code>
						<span>First element</span>
					</button>
					<button data-snip="$.store.books[-1]" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[-1]</code>
						<span>Last element</span>
					</button>
					<button data-snip="$.store.books[0:3]" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[0:3]</code>
						<span>Slice [0–3)</span>
					</button>
					<button data-snip="$.store.books[*]" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[*]</code>
						<span>All books</span>
					</button>
					<button data-snip="$.store.books[*].title" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[*].title</code>
						<span>All titles</span>
					</button>

					<!-- Group: Filters -->
					<div class="col-span-full mt-2 font-mono text-caption uppercase tracking-wide text-mute">Filter expressions</div>
					<button data-snip="$.store.books[?(@.inStock == true)]" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[?(@.inStock == true)]</code>
						<span>In-stock books</span>
					</button>
					<button data-snip="$.store.books[?(@.price < 40)]" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[?(@.price &lt; 40)]</code>
						<span>Books under $40</span>
					</button>
					<button data-snip='$.store.books[?(@.author == "Martin Fowler")]' data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[?(@.author == "Martin Fowler")]</code>
						<span>Filter by author</span>
					</button>

					<!-- Group: Recursive descent -->
					<div class="col-span-full mt-2 font-mono text-caption uppercase tracking-wide text-mute">Recursive descent</div>
					<button data-snip="$..author" data-snip-lang="jsonpath" class="jb-snip">
						<code>$..author</code>
						<span>All authors (deep)</span>
					</button>
					<button data-snip="$..price" data-snip-lang="jsonpath" class="jb-snip">
						<code>$..price</code>
						<span>All prices (deep)</span>
					</button>
					<button data-snip="$..books.length" data-snip-lang="jsonpath" class="jb-snip">
						<code>$..books.length</code>
						<span>Array length</span>
					</button>

					<!-- Group: Multiple -->
					<div class="col-span-full mt-2 font-mono text-caption uppercase tracking-wide text-mute">Multiple selectors</div>
					<button data-snip="$.store.books[*]['title','author']" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[*]['title','author']</code>
						<span>Two fields</span>
					</button>
					<button data-snip="$.store.books[0,2,4]" data-snip-lang="jsonpath" class="jb-snip">
						<code>$.store.books[0,2,4]</code>
						<span>Multiple indices</span>
					</button>
				</div>
			</div>

			<!-- JMESPath snippets -->
			<div data-snip-panel="jmespath" class="hidden">
				<div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
					<div class="col-span-full font-mono text-caption uppercase tracking-wide text-mute">Basic access</div>
					<button data-snip="store.name" data-snip-lang="jmespath" class="jb-snip">
						<code>store.name</code>
						<span>Single field</span>
					</button>
					<button data-snip="store.books[0].title" data-snip-lang="jmespath" class="jb-snip">
						<code>store.books[0].title</code>
						<span>Nested field</span>
					</button>
					<button data-snip="store.books[*].title" data-snip-lang="jmespath" class="jb-snip">
						<code>store.books[*].title</code>
						<span>All titles</span>
					</button>
					<button data-snip="store.books[-1].title" data-snip-lang="jmespath" class="jb-snip">
						<code>store.books[-1].title</code>
						<span>Last title</span>
					</button>

					<div class="col-span-full mt-2 font-mono text-caption uppercase tracking-wide text-mute">Filter projections</div>
					<button data-snip="store.books[?inStock == `true`].title" data-snip-lang="jmespath" class="jb-snip">
						<code>store.books[?inStock == `true`].title</code>
						<span>In-stock titles</span>
					</button>
					<button data-snip="store.books[?price < `40`]" data-snip-lang="jmespath" class="jb-snip">
						<code>store.books[?price &lt; `40`]</code>
						<span>Books under $40</span>
					</button>
					<button data-snip="store.books[?contains(tags, 'programming')]" data-snip-lang="jmespath" class="jb-snip">
						<code>store.books[?contains(tags, 'programming')]</code>
						<span>Books with tag</span>
					</button>

					<div class="col-span-full mt-2 font-mono text-caption uppercase tracking-wide text-mute">Multi-select &amp; functions</div>
					<button data-snip="store.books[*].{title: title, price: price}" data-snip-lang="jmespath" class="jb-snip">
						<code>store.books[*].&#123;title: title, price: price&#125;</code>
						<span>Project two fields</span>
					</button>
					<button data-snip="length(store.books)" data-snip-lang="jmespath" class="jb-snip">
						<code>length(store.books)</code>
						<span>Book count</span>
					</button>
					<button data-snip="max_by(store.books, &price).title" data-snip-lang="jmespath" class="jb-snip">
						<code>max_by(store.books, &price).title</code>
						<span>Most expensive title</span>
					</button>
					<button data-snip="sort_by(store.books, &price)[*].title" data-snip-lang="jmespath" class="jb-snip">
						<code>sort_by(store.books, &price)[*].title</code>
						<span>Titles by price</span>
					</button>
					<button data-snip="keys(store)" data-snip-lang="jmespath" class="jb-snip">
						<code>keys(store)</code>
						<span>Store keys</span>
					</button>
					<button data-snip="to_array(store.books[0])" data-snip-lang="jmespath" class="jb-snip">
						<code>to_array(store.books[0])</code>
						<span>Coerce to array</span>
					</button>
				</div>
			</div>

			<!-- jq snippets -->
			<div data-snip-panel="jq" class="hidden">
				<div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
					<div class="col-span-full font-mono text-caption uppercase tracking-wide text-mute">Basic access</div>
					<button data-snip=".store.name" data-snip-lang="jq" class="jb-snip">
						<code>.store.name</code>
						<span>Single field</span>
					</button>
					<button data-snip=".store.books[0].title" data-snip-lang="jq" class="jb-snip">
						<code>.store.books[0].title</code>
						<span>Nested field</span>
					</button>
					<button data-snip=".store.books[].title" data-snip-lang="jq" class="jb-snip">
						<code>.store.books[].title</code>
						<span>All titles (stream)</span>
					</button>
					<button data-snip="[.store.books[].title]" data-snip-lang="jq" class="jb-snip">
						<code>[.store.books[].title]</code>
						<span>All titles (array)</span>
					</button>
					<button data-snip=".store.books | length" data-snip-lang="jq" class="jb-snip">
						<code>.store.books | length</code>
						<span>Book count</span>
					</button>
					<button data-snip=".store | keys" data-snip-lang="jq" class="jb-snip">
						<code>.store | keys</code>
						<span>Store keys</span>
					</button>

					<div class="col-span-full mt-2 font-mono text-caption uppercase tracking-wide text-mute">Filter &amp; transform</div>
					<button data-snip='.store.books[] | select(.inStock == true)' data-snip-lang="jq" class="jb-snip">
						<code>.store.books[] | select(.inStock == true)</code>
						<span>In-stock books</span>
					</button>
					<button data-snip='.store.books[] | select(.price < 40)' data-snip-lang="jq" class="jb-snip">
						<code>.store.books[] | select(.price &lt; 40)</code>
						<span>Books under $40</span>
					</button>
					<button data-snip='.store.books | map(select(.inStock)) | map(.title)' data-snip-lang="jq" class="jb-snip">
						<code>.store.books | map(select(.inStock)) | map(.title)</code>
						<span>In-stock titles</span>
					</button>
					<button data-snip='.store.books | map({title, price})' data-snip-lang="jq" class="jb-snip">
						<code>.store.books | map(&#123;title, price&#125;)</code>
						<span>Project two fields</span>
					</button>

					<div class="col-span-full mt-2 font-mono text-caption uppercase tracking-wide text-mute">Sort, group &amp; aggregate</div>
					<button data-snip='.store.books | sort_by(.price)' data-snip-lang="jq" class="jb-snip">
						<code>.store.books | sort_by(.price)</code>
						<span>Sort by price</span>
					</button>
					<button data-snip='.store.books | group_by(.inStock)' data-snip-lang="jq" class="jb-snip">
						<code>.store.books | group_by(.inStock)</code>
						<span>Group by inStock</span>
					</button>
					<button data-snip='.store.books | max_by(.price)' data-snip-lang="jq" class="jb-snip">
						<code>.store.books | max_by(.price)</code>
						<span>Most expensive</span>
					</button>
					<button data-snip='[.store.books[].price] | add' data-snip-lang="jq" class="jb-snip">
						<code>[.store.books[].price] | add</code>
						<span>Sum all prices</span>
					</button>

					<div class="col-span-full mt-2 font-mono text-caption uppercase tracking-wide text-mute">Advanced jq</div>
					<button data-snip='.store.books[] | .title + " ($" + (.price|tostring) + ")"' data-snip-lang="jq" class="jb-snip">
						<code>.store.books[] | .title + " ($" + (.price|tostring) + ")"</code>
						<span>String interpolation</span>
					</button>
					<button data-snip='.store.books | to_entries | map({(.key|tostring): .value.title}) | add' data-snip-lang="jq" class="jb-snip">
						<code>.store.books | to_entries | map(&#123;(.key|tostring): .value.title&#125;) | add</code>
						<span>Index → title map</span>
					</button>
					<button data-snip='.store.books | map(.tags[]) | unique | sort' data-snip-lang="jq" class="jb-snip">
						<code>.store.books | map(.tags[]) | unique | sort</code>
						<span>All unique tags</span>
					</button>
					<button data-snip='reduce .store.books[] as $b (0; . + $b.price)' data-snip-lang="jq" class="jb-snip">
						<code>reduce .store.books[] as $b (0; . + $b.price)</code>
						<span>Reduce sum</span>
					</button>
					<button data-snip='[paths] | length' data-snip-lang="jq" class="jb-snip">
						<code>[paths] | length</code>
						<span>Count all paths</span>
					</button>
					<button data-snip='.store.books | map(select(.inStock)) | length' data-snip-lang="jq" class="jb-snip">
						<code>.store.books | map(select(.inStock)) | length</code>
						<span>Count in-stock</span>
					</button>
				</div>
			</div>
		</div>
	</details>

	<!-- Status bar -->
	<div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-hairline bg-canvas-soft px-3 py-2 text-body-sm">
		<span
			id="jb-qt-status"
			class="inline-flex items-center gap-1.5 font-medium"
			role="status"
			aria-live="polite"
		>
			<span class="h-2 w-2 rounded-full bg-mute" data-dot></span>
			<span data-label>Ready</span>
		</span>
		<span class="ml-auto inline-flex items-center gap-1.5 text-caption text-mute">
			<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M8 1.5 3 3.5v3.2c0 3 2.1 5.8 5 6.8 2.9-1 5-3.8 5-6.8V3.5L8 1.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
			</svg>
			Processed locally — nothing uploaded
		</span>
	</div>
</div>

<style>
/* ── Input textarea ─────────────────────────────────────────────────────────── */
#jb-qt-input {
	background-color: var(--color-editor-bg);
	color: var(--color-editor-fg);
	font-family: var(--font-mono);
	font-size: 13px;
	line-height: 1.6;
	padding: 12px 14px;
	border: none;
	outline: none;
	resize: none;
	display: block;
	tab-size: 2;
	width: 100%;
}
/* ── Result pane ────────────────────────────────────────────────────────────── */
#jb-qt-result {
	background-color: var(--color-editor-bg);
	color: var(--color-editor-fg);
}
#jb-qt-empty, #jb-qt-loading {
	display: flex;
	height: 100%;
	align-items: center;
	justify-content: center;
}
/* ── Result value syntax colours (dark) ─────────────────────────────────────── */
:global(#jb-qt-out .jb-q-s)  { color: var(--color-cyan); }
:global(#jb-qt-out .jb-q-n)  { color: var(--color-violet-soft); }
:global(#jb-qt-out .jb-q-b)  { color: var(--color-warning); }
:global(#jb-qt-out .jb-q-nl) { color: var(--color-mute); }
:global(#jb-qt-out .jb-q-k)  { color: var(--color-editor-fg); font-weight: 500; }
:global(#jb-qt-out .jb-q-p)  { color: var(--color-hairline-strong); }
:global(#jb-qt-out .jb-q-idx){ color: var(--color-mute); user-select: none; font-size: 11px; padding-right: 8px; }
