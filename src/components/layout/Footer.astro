---
/**
 * Footer mega-nav. Internal-links every tool landing page (the SEO surface).
 * Pages not yet shipped render as muted, non-linked "soon" rows so we never
 * publish a dead link.
 */
import { FOOTER_NAV, SITE_NAME, withSlash } from '../../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
	<div class="container-page py-16">
		<div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-6">
			<!-- Brand column -->
			<div class="col-span-2 md:col-span-1">
				<a href="/" class="flex items-center gap-2.5" aria-label={`${SITE_NAME} home`}>
					<span
						class="grid h-7 w-7 place-items-center rounded-md bg-ink font-mono text-code leading-none text-on-primary"
					>{'{}'}</span>
					<span class="text-body-lg font-semibold tracking-[-0.4px]">JSON Beam</span>
				</a>
				<p class="mt-3 max-w-56 text-body-sm text-body">
					The professional JSON workbench. Private, fast, free.
				</p>
			</div>

			<!-- Nav columns -->
			{
				FOOTER_NAV.map((col) => (
					<nav aria-label={col.title}>
						<h2 class="font-mono text-caption uppercase tracking-wide text-mute">
							{col.title}
						</h2>
						<ul class="mt-3 space-y-2.5">
							{col.links.map((link) =>
								link.soon ? (
									<li class="flex items-center gap-2 text-body-sm text-mute">
										<span>{link.label}</span>
										<span class="rounded-full bg-canvas-soft px-2 py-0.5 text-caption text-mute">
											soon
										</span>
									</li>
								) : (
									<li>
										<a
											href={withSlash(link.href)}
											class="text-body-sm text-body transition-colors hover:text-ink"
										>
											{link.label}
										</a>
									</li>
								),
							)}
						</ul>
					</nav>
				))
			}
		</div>

		<!-- Bottom bar -->
		<div class="mt-12 flex flex-col gap-5 border-t border-hairline pt-6 text-body-sm text-mute">
			<nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-2">
				<a href="/about/" class="transition-colors hover:text-ink">About</a>
				<a href="/contact/" class="transition-colors hover:text-ink">Contact</a>
				<a href="/privacy/" class="transition-colors hover:text-ink">Privacy Policy</a>
				<a href="/cookie-policy/" class="transition-colors hover:text-ink">Cookie Policy</a>
				<a href="/terms/" class="transition-colors hover:text-ink">Terms &amp; Conditions</a>
				<a href="/disclaimer/" class="transition-colors hover:text-ink">Disclaimer</a>
			</nav>
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<p>© {year} {SITE_NAME}. Free to use, no account required.</p>
				<p class="flex items-center gap-2">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M8 1.5 3 3.5v3.2c0 3 2.1 5.8 5 6.8 2.9-1 5-3.8 5-6.8V3.5L8 1.5Z"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linejoin="round"
					></path>
				</svg>
				Private by design — nothing you paste leaves your browser.
			</p>
			</div>
		</div>
	</div>
</footer>
