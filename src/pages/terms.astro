---
import ContentPage from '../components/layout/ContentPage.astro';
import type { FaqItem } from '../lib/seo/jsonld';

const faqs: FaqItem[] = [
	{
		question: 'Does JSON Beam cost anything?',
		answer:
			'No. The core tools are free to use with no account, no signup, and no usage limits. These terms govern that free use.',
	},
	{
		question: 'Can I use JSON Beam for work or commercial data?',
		answer:
			'Yes. You can use the tools for personal, internal, and commercial work. Because all processing is client-side, your data never leaves your browser — which is what makes it safe for sensitive or proprietary content.',
	},
	{
		question: 'Do you guarantee the output is correct?',
		answer:
			'The tools are provided “as is”. They are built to be accurate and reliable, but you are responsible for verifying any output before relying on it in production or for critical decisions.',
	},
];
---

<ContentPage
	slug="/terms"
	title="Terms & Conditions — JSON Beam"
	description="The terms of use for JSON Beam, the free client-side JSON workbench. Read the rules, disclaimers, and your rights when using our tools."
	breadcrumbLabel="Terms & Conditions"
	h1="Terms & conditions."
	intro="These terms govern your use of JSON Beam. They are written to be readable — the short version is: use the tools freely and responsibly; they are provided as is."
	lastUpdated="June 22, 2026"
	faqs={faqs}
>
	<h2>1. Acceptance of these terms</h2>
	<p>
		By accessing or using JSON Beam (the “Service”), available at
		<code>jsonbeam.com</code>, you agree to these Terms &amp; Conditions. If you do not agree
		with them, please do not use the Service.
	</p>

	<h2>2. The Service</h2>
	<p>
		JSON Beam is a collection of free, browser-based tools for working with JSON — including
		formatting, validation, repair, querying, comparison, visualization, and conversion. All
		processing happens locally in your browser; the Service does not upload, store, or transmit
		the content you work with. See our <a href="/privacy/">privacy policy</a> for details.
	</p>

	<h2>3. License to use</h2>
	<p>
