---
import ToolPage from '../components/ToolPage.astro';
import type { FaqItem } from '../lib/jsonld';
import type { RelatedTool } from '../components/ToolPage.astro';

const steps = [
	{ title: 'Paste or type your JSON', body: 'Drop it straight into the editor. Nothing is uploaded — it stays in your browser.' },
	{ title: 'Choose your indentation', body: 'Pick 2 spaces, 4 spaces, or tabs to match your codebase style.' },
	{ title: 'Format, minify, or repair', body: 'Beautify for readability, minify for the wire, or repair to fix common mistakes.' },
	{ title: 'Copy or download', body: 'Grab the result to your clipboard or save it as data.json in one click.' },
];

const whatIs = [
	'JSON (JavaScript Object Notation) is the lingua franca of APIs and config files, but it is unforgiving about syntax and painful to read once it has been minified. A formatter re-indents it into a clean, scannable shape.',
	"JSON Beam goes further than a pretty-printer. <strong class='font-medium text-ink'>Format</strong> re-indents with your chosen spacing; <strong class='font-medium text-ink'>Minify</strong> strips every byte of whitespace for the wire; <strong class='font-medium text-ink'>Validate</strong> underlines exactly where and why parsing fails; and <strong class='font-medium text-ink'>Repair</strong> fixes the usual suspects — trailing commas, single quotes, comments, and unquoted keys — then re-formats the result.",
	'Everything runs locally in your browser, so you can safely format sensitive payloads, and it keeps working offline.',
];

const faqs: FaqItem[] = [
	{
		question: 'What does a JSON formatter do?',
		answer:
			'A JSON formatter takes raw or minified JSON and re-indents it into a clean, human-readable structure with consistent spacing and line breaks. JSON Beam also minifies (removes all whitespace), validates (flags syntax errors), and repairs (fixes common mistakes) the same document.',
	},
	{
		question: 'How do I format JSON?',
		answer:
			'Paste or type your JSON into the editor and click Format — it is instantly re-indented into a clean, readable structure with consistent spacing. You can also minify it to a single line, and invalid JSON is flagged as you type so you can fix it before formatting. Nothing is uploaded; it all runs in your browser.',
	},
	{
		question: 'Is this JSON formatter free and private?',
		answer:
			'Yes. It is completely free with no account or signup, and it runs entirely in your browser. Your JSON is never uploaded to a server, so it is safe to format sensitive or proprietary data.',
	},
	{
		question: 'Can it fix invalid or broken JSON?',
		answer:
			'Yes. The Repair action fixes the most common problems automatically: trailing commas, single quotes instead of double quotes, comments, and unquoted keys. After repairing, the JSON is re-formatted so you immediately get a clean, valid result.',
	},
	{
		question: 'How do I find the error in my JSON?',
		answer:
			'As you type, invalid JSON is underlined exactly where parsing fails, and the status bar shows the specific reason and position. Hover the underline to read the error message inline, then fix it in place.',
	},
	{
		question: 'Does it work offline?',
		answer:
			'Yes. Because all processing happens client-side, the formatter keeps working with no network connection once the page has loaded.',
	},
];

const related: RelatedTool[] = [
	{ name: 'JSON Editor', href: '/json-editor', desc: 'A live, syntax-highlighted editor.' },
	{ name: 'JSON Validator', href: '/json-validator', desc: 'Line-anchored syntax errors.' },
	{ name: 'JSON Repair', href: '/json-repair', desc: 'Auto-fix broken JSON.' },
	{ name: 'JSON Beautifier', href: '/json-beautifier', desc: 'Clean, readable indentation.' },
];
---

<ToolPage
	variant="format"
	slug="/json-formatter"
	title="JSON Formatter — Beautify, Validate & Repair JSON"
	description="Free online JSON formatter. Beautify, minify, validate, and repair JSON in your browser — 100% private, no upload, no signup. Fast even on large files."
	breadcrumbLabel="JSON Formatter"
	h1="JSON formatter, validator &amp; repair — right in your browser."
	intro="Beautify, minify, validate, and fix JSON instantly. Private by design — nothing you paste ever leaves your browser."
	howToTitle="Format JSON in four steps."
	steps={steps}
	whatIsTitle="A formatter that does the whole job."
	whatIs={whatIs}
	faqTitle="JSON formatter questions."
	faqs={faqs}
	related={related}
/>
