---
import ToolPage from '../components/ToolPage.astro';
import type { FaqItem } from '../lib/jsonld';
import type { RelatedTool } from '../components/ToolPage.astro';

const steps = [
	{ title: 'Paste or type your JSON', body: 'Start editing immediately in a syntax-highlighted editor. Nothing is uploaded — it stays in your browser.' },
	{ title: 'Edit with live feedback', body: 'Brackets match as you type and errors are underlined the moment they appear, with the reason in the status bar.' },
	{ title: 'Format or repair', body: 'Beautify with your chosen indentation, minify for the wire, or auto-fix common mistakes in one click.' },
	{ title: 'Copy or download', body: 'Send your edited JSON to the clipboard or save it as data.json — no account, no limits.' },
];

const whatIs = [
	'A JSON editor is more than a text box — it understands the JSON you are writing. JSON Beam gives you syntax highlighting, bracket matching, and live validation, so structural mistakes surface the instant you make them rather than after you paste the result somewhere else.',
	"Because it doubles as an online JSON editor and validator, you can format, minify, and repair without leaving the page. <strong class='font-medium text-ink'>Format</strong> re-indents to your chosen spacing; <strong class='font-medium text-ink'>Minify</strong> strips whitespace for the wire; <strong class='font-medium text-ink'>Validate</strong> pinpoints the exact error; and <strong class='font-medium text-ink'>Repair</strong> fixes trailing commas, single quotes, comments, and unquoted keys.",
	'Everything runs locally in your browser, so you can edit sensitive or proprietary JSON safely, it stays smooth on large files, and it keeps working offline.',
];

const faqs: FaqItem[] = [
	{
		question: 'What is an online JSON editor?',
		answer:
			'An online JSON editor is a browser-based workspace for writing and changing JSON with help from the tool itself — syntax highlighting, bracket matching, and live validation — so you catch mistakes as you type. JSON Beam adds one-click formatting, minifying, and repair on top of the editor.',
	},
	{
		question: 'Is this JSON editor free?',
		answer:
			'Yes, completely. There is no account and no usage limits. It is a free online JSON editor that runs entirely in your browser, so you can use it as often as you like.',
	},
	{
		question: 'Does it validate JSON as I edit?',
		answer:
			'Yes. The editor checks your JSON continuously and underlines the exact character where parsing fails, with the reason and position shown in the status bar — so it works as a JSON editor and validator in one.',
	},
	{
		question: 'Can I format and repair JSON in the editor?',
		answer:
			'Yes. Format re-indents your JSON with 2 spaces, 4 spaces, or tabs; Minify removes all whitespace; and Repair automatically fixes the most common mistakes — trailing commas, single quotes, comments, and unquoted keys — then re-formats the result.',
	},
	{
		question: 'Is my JSON private?',
		answer:
			'Always. Every keystroke is processed in your browser. Your JSON is never uploaded, logged, or sent to a server, so the editor is safe for sensitive or proprietary data and works offline once the page has loaded.',
	},
	{
		question: 'Can it handle large JSON files?',
		answer:
			'Yes. The editor is engineered to stay responsive on large documents — into the tens of megabytes — where many online editors freeze the tab.',
	},
];

const related: RelatedTool[] = [
	{ name: 'JSON Formatter', href: '/json-formatter', desc: 'Beautify, minify, validate & repair.' },
	{ name: 'JSON Validator', href: '/json-validator', desc: 'Line-anchored syntax errors.' },
	{ name: 'JSON Viewer', href: '/json-viewer', desc: 'Explore structure as a tree.' },
	{ name: 'JSON Repair', href: '/json-repair', desc: 'Auto-fix broken JSON.' },
];
---

<ToolPage
	variant="format"
	slug="/json-editor"
	title="JSON Editor — Edit, Validate & Format JSON Online Free"
	description="Free online JSON editor. Edit, format, validate, and repair JSON in a fast, syntax-highlighted editor — 100% in your browser, nothing uploaded, no signup."
	breadcrumbLabel="JSON Editor"
	h1="JSON editor — edit, validate, and format in your browser."
	intro="A fast, syntax-highlighted JSON editor with live validation, one-click formatting, and auto-repair. Everything stays in your browser — nothing you edit is ever uploaded."
	howToTitle="Edit JSON in four steps."
	steps={steps}
	whatIsTitle="An editor that understands your JSON."
	whatIs={whatIs}
	faqTitle="JSON editor questions."
	faqs={faqs}
	related={related}
/>
