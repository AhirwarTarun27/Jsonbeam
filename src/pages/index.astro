	<style is:global>
	/* ── The homepage hero mockup ────────────────────────────────────────────
	   A STATIC picture of the editor, not the editor (contract 1: this page
	   ships 0 KB of app JS). It is a fixed dark surface on a light marketing
	   page and never themes, so every colour below is either a design token or
	   a white alpha over that one known surface.

	   The ~20 distinct `rgba(255,255,255,α)` values stay literal on purpose.
	   They are one-off opacities inside a single decorative illustration —
	   naming them would put twenty tokens nobody can choose between ("is this
	   the .35 hairline or the .42 one?") into a layer that ships to every
	   route. Tokens earn their keep by being reused across surfaces; these are
	   not, and pretending otherwise makes the token layer worse, not better. */
		/* Scoped into @layer components so Tailwind's `utilities` layer (hidden,
		   sm:inline-flex, …) wins — letting the toolbar reflow responsively. */
		@layer components {
		/* ══ Hero workbench mockup — pure CSS/SVG, ships 0 KB of JS ══════════════
		   Two faithful full-screen "screens" (Formatter ⇄ Graph) stacked and
		   auto cross-fading. Syntax colours mirror the real dark editor theme. */

		/* shared syntax tokens (code spans injected via set:html) */
		.hero-wb .k { color: var(--color-editor-fg); }
		.hero-wb .s { color: var(--color-cyan); }
		.hero-wb .n { color: var(--color-violet-soft); }
		.hero-wb .b { color: var(--color-warning); }
		.hero-wb .p { color: var(--color-hairline-strong); }

		.hero-screen {
			position: absolute; inset: 0;
			display: flex; flex-direction: column;
			overflow: hidden;
			border-radius: 12px;
			background: var(--color-ink);
			box-shadow: inset 0 0 0 1px rgba(255,255,255,.08), var(--shadow-e5);
			will-change: opacity, transform;
		}
		.hero-screen-graph { opacity: 0; animation: hero-fade-graph 12s ease-in-out infinite; }
		.hero-screen-fmt   { opacity: 1; animation: hero-fade-fmt   12s ease-in-out infinite; }

		@keyframes hero-fade-fmt {
			0%, 42% { opacity: 1; transform: scale(1); }
			50%     { opacity: 0; transform: scale(.988); }
			90%     { opacity: 0; transform: scale(.988); }
			100%    { opacity: 1; transform: scale(1); }
		}
		@keyframes hero-fade-graph {
			0%, 42% { opacity: 0; transform: scale(.988); }
			50%     { opacity: 1; transform: scale(1); }
			90%     { opacity: 1; transform: scale(1); }
			100%    { opacity: 0; transform: scale(.988); }
		}

		/* slim brand bar */
		.hero-bar {
			display: flex; align-items: center; gap: 3px;
			flex: 0 0 auto; height: 42px; padding: 0 10px;
			background: var(--color-editor-chrome);
			border-bottom: 1px solid rgba(255,255,255,.07);
			font-family: var(--font-mono); font-size: 10px; line-height: 1;
			white-space: nowrap; overflow: hidden;
		}
		.hero-chip {
			display: grid; place-items: center; flex: 0 0 auto;
			width: 22px; height: 22px; border-radius: 7px;
			background: var(--color-ink); color: var(--color-canvas);
			border: 1px solid rgba(255,255,255,.16);
			font-weight: 600; font-size: 12px; letter-spacing: -1.5px;
		}
		.hero-brand { color: rgba(255,255,255,.85); font-weight: 500; }
		.hero-dot { color: rgba(255,255,255,.3); }
		.hero-tool-fmt { color: var(--color-canvas); }
		.hero-tool-graph { color: var(--color-cyan); }
		/* :where() keeps these at specificity 0 so Tailwind's responsive
		   `hidden`/`sm:inline-flex` utilities win and the toolbar can reflow. */
		:where(.hero-search) {
			display: inline-flex; align-items: center; gap: 4px;
			color: rgba(255,255,255,.42);
			border: 1px solid rgba(255,255,255,.12);
			border-radius: 6px; padding: 3px 7px;
