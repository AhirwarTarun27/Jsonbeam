---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import MeshGradient from '../components/MeshGradient.astro';
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION } from '../consts';
import { webSite, softwareApplication, faqPage, type FaqItem } from '../lib/jsonld';

const title = `${SITE_NAME} — Free Online JSON Formatter, Viewer & Validator`;
const description =
	'Free online JSON formatter, viewer, validator & converter. Beautify, minify, repair, diff & visualize JSON in your browser — private, no upload, no signup.';

const promises = [
	{
		title: 'Private by design',
		body: 'Every byte is processed in your browser. Nothing is uploaded, logged, or sent to a server. Ever.',
		icon: 'shield',
	},
	{
		title: 'No ceiling',
		body: 'Format and explore files into the tens of megabytes without freezing the tab — where other tools give up.',
		icon: 'layers',
	},
	{
		title: 'Instant',
		body: 'Sub-second load. The editor is usable before the rest of the page has even finished painting.',
		icon: 'bolt',
	},
	{
		title: 'Free forever',
		body: 'No signup. No upload. The core is open source — verifiable, not just promised.',
		icon: 'heart',
	},
];

const tools = [
	{ name: 'JSON Formatter', href: '/json-formatter', desc: 'Beautify, minify, repair, and validate — the anchor tool.', live: true },
	{ name: 'JSON Editor', href: '/json-editor', desc: 'A fast, syntax-highlighted editor with live validation.', live: true },
	{ name: 'JSON Validator', href: '/json-validator', desc: 'Pinpoint syntax errors with line-anchored messages.', live: true },
	{ name: 'JSON Viewer', href: '/json-viewer', desc: 'Explore JSON as a collapsible, color-coded tree. Copy any path.', live: true },
	{ name: 'JSON Visualizer', href: '/json-visualizer', desc: 'See JSON as a pan-and-zoom node graph.', live: true },
	{ name: 'JSON Diff', href: '/json-diff', desc: 'Compare two documents with a semantic, structure-aware diff.', live: true },
	{ name: 'JSON Repair', href: '/json-repair', desc: 'Fix trailing commas, single quotes, comments, unquoted keys.', live: true },
	{ name: 'JSON Minifier', href: '/json-minifier', desc: 'Strip whitespace down to the smallest possible payload.', live: true },
	{ name: 'JSON → CSV / YAML / TS / Go', href: '/json-to-csv', desc: 'Convert to CSV & YAML, or generate TypeScript and Go types.', live: true },
];

const faqs: FaqItem[] = [
	{
		question: 'Is my JSON uploaded to a server?',
		answer:
			'No. JSON Beam runs entirely in your browser using client-side JavaScript. Your data is never uploaded, transmitted, logged, or stored anywhere. You can confirm this by opening your browser dev tools network tab, or by using the tool fully offline.',
	},
	{
		question: 'Does JSON Beam cost anything?',
		answer:
			'No. The core tools are free forever, with no account and no usage limits. The project is built to be open source so the privacy claims are verifiable rather than just stated.',
	},
	{
		question: 'How large a file can it handle?',
		answer:
			'Far more than typical online formatters. Parsing and formatting are engineered to handle files into the tens of megabytes without freezing the tab, with large-file streaming and virtualization expanding that ceiling further.',
	},
	{
		question: 'Do I need to install anything?',
		answer:
			'No. JSON Beam is a website that works in any modern browser. It can also be installed as a progressive web app and used offline, with no extensions or downloads required.',
	},
];

// Hand-coloured JSON for the hero mockup. Built as a string so literal braces
// don't collide with Astro's expression syntax; rendered via set:html.
const heroSnippet = [
	'<span class="p">{</span>',
	'  <span class="k">"app"</span><span class="p">:</span> <span class="s">"JSON Beam"</span><span class="p">,</span>',
	'  <span class="k">"private"</span><span class="p">:</span> <span class="b">true</span><span class="p">,</span>',
	'  <span class="k">"upload"</span><span class="p">:</span> <span class="n">null</span><span class="p">,</span>',
	'  <span class="k">"maxFileSizeMB"</span><span class="p">:</span> <span class="n">100</span><span class="p">,</span>',
	'  <span class="k">"modes"</span><span class="p">:</span> <span class="p">[</span><span class="s">"text"</span><span class="p">,</span> <span class="s">"tree"</span><span class="p">,</span> <span class="s">"table"</span><span class="p">,</span> <span class="s">"graph"</span><span class="p">]</span>',
	'<span class="p">}</span>',
].join('\n');

const jsonLd = [
	webSite(),
	softwareApplication({ name: SITE_NAME, description: SITE_DESCRIPTION, url: SITE_URL }),
	faqPage(faqs),
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
	<!-- ── Hero ─────────────────────────────────────────────────────────── -->
	<section class="relative overflow-hidden">
		<MeshGradient />
		<div class="container-page relative z-10 flex flex-col items-center pt-24 pb-16 text-center sm:pt-28">
			<span
				class="inline-flex items-center gap-2 rounded-full bg-canvas-soft px-3 py-1 font-mono text-caption text-body shadow-e1"
			>
				<span class="inline-block h-1.5 w-1.5 rounded-full bg-cyan-deep"></span>
				100% client-side · nothing uploaded
			</span>

			<h1 class="mt-6 max-w-3xl text-balance text-display-xl">
				The JSON workbench that never leaves your browser.
			</h1>

			<p class="mt-5 max-w-2xl text-body-lg text-body">
				Format, validate, repair, and convert JSON instantly — free, private, and
				fast enough for the files other tools choke on.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<Button href="/json-formatter">Open the formatter</Button>
				<Button href="#tools" variant="secondary">Explore tools</Button>
			</div>

			<p class="mt-5 font-mono text-caption text-mute">
				No upload · No signup · Works offline
			</p>

			<!-- Static code mockup (code-editor-mockup token) -->
			<div class="mt-14 w-full max-w-2xl text-left">
				<div class="overflow-hidden rounded-md bg-ink shadow-e5">
					<div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
						<span class="h-3 w-3 rounded-full bg-white/20"></span>
						<span class="h-3 w-3 rounded-full bg-white/20"></span>
						<span class="h-3 w-3 rounded-full bg-white/20"></span>
						<span class="ml-3 font-mono text-caption text-white/45">data.json</span>
					</div>
					<pre class="hero-code overflow-x-auto p-6 font-mono text-code leading-relaxed"><code set:html={heroSnippet} /></pre>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Brand promises ───────────────────────────────────────────────── -->
	<section class="bg-canvas-soft">
		<div class="container-page py-24">
			<div class="max-w-2xl">
				<p class="font-mono text-caption uppercase tracking-wide text-mute">Why JSON Beam</p>
				<h2 class="mt-3 text-display-lg">Built for the JSON you actually work with.</h2>
			</div>
			<div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					promises.map((p) => (
						<div class="rounded-md bg-canvas p-6 shadow-e3">
							<div class="grid h-9 w-9 place-items-center rounded-md bg-canvas-soft-2 text-ink">
								<svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
									{p.icon === 'shield' && (
										<path d="M10 2 3.5 4.5v4c0 3.7 2.7 7.1 6.5 8 3.8-.9 6.5-4.3 6.5-8v-4L10 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
									)}
									{p.icon === 'layers' && (
										<path d="M10 3 3 6.5 10 10l7-3.5L10 3Zm-7 7L10 13.5 17 10m-14 3.5L10 17l7-3.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
									)}
									{p.icon === 'bolt' && (
										<path d="M11 2 4 11h5l-1 7 7-9h-5l1-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
									)}
									{p.icon === 'heart' && (
										<path d="M10 16.5S3.5 12.4 3.5 7.8A3.3 3.3 0 0 1 10 6a3.3 3.3 0 0 1 6.5 1.8c0 4.6-6.5 8.7-6.5 8.7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
									)}
								</svg>
							</div>
							<h3 class="mt-4 text-display-sm">{p.title}</h3>
							<p class="mt-2 text-body-sm text-body">{p.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── Dark workbench band (polarity flip = depth cue) ──────────────── -->
	<section class="bg-ink text-on-primary">
		<div class="container-page py-24">
			<div class="grid items-center gap-12 lg:grid-cols-2">
				<div>
					<p class="font-mono text-caption uppercase tracking-wide text-white/45">The workbench</p>
					<h2 class="mt-3 text-display-lg">One document. Every view.</h2>
					<p class="mt-4 max-w-md text-body-md text-white/65">
						Text, tree, table, and graph — four ways to read the same JSON, with
						your edits round-tripping losslessly between them. The full workbench is
						on the way; the formatter is live today.
					</p>
					<div class="mt-7">
						<Button href="/json-formatter">Try the formatter now</Button>
					</div>
				</div>
				<div class="rounded-md bg-white/[0.04] p-2 shadow-e1">
					<div class="flex flex-wrap gap-1.5 rounded-sm bg-black/30 p-1.5">
						{
							['Text', 'Tree', 'Table', 'Graph'].map((mode, i) => (
								<span
									class:list={[
										'rounded-sm px-4 py-2 font-mono text-body-sm',
										i === 0 ? 'bg-white text-ink' : 'text-white/55',
									]}
								>
									{mode}
								</span>
							))
						}
					</div>
					<div class="px-4 py-6 font-mono text-code text-white/70">
						<p><span class="text-white/35">// switch modes — never lose your edits</span></p>
						<p class="mt-2">document.view = <span style="color: var(--color-cyan)">"tree"</span></p>
						<p>document.dirty = <span style="color: var(--color-warning)">false</span></p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Tools grid ───────────────────────────────────────────────────── -->
	<section id="tools" class="scroll-mt-20 bg-canvas">
		<div class="container-page py-24">
			<div class="max-w-2xl">
				<p class="font-mono text-caption uppercase tracking-wide text-mute">Tools</p>
				<h2 class="mt-3 text-display-lg">Pick a tool. Each one is its own page.</h2>
				<p class="mt-4 text-body-md text-body">
					Focused, fast entry points — formatting today, the full suite rolling out next.
				</p>
			</div>
			<div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					tools.map((tool) =>
						tool.live ? (
							<a
								href={tool.href}
								class="group flex flex-col rounded-md bg-canvas p-6 shadow-e3 transition-shadow hover:shadow-e4"
							>
								<div class="flex items-center justify-between">
									<h3 class="text-display-sm">{tool.name}</h3>
									<span class="rounded-full bg-link-bg-soft px-2 py-0.5 text-caption text-link-deep">Live</span>
								</div>
								<p class="mt-2 text-body-sm text-body">{tool.desc}</p>
								<span class="mt-4 inline-flex items-center gap-1 text-body-sm font-medium text-link">
									Open
									<span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
								</span>
							</a>
						) : (
							<div class="flex flex-col rounded-md bg-canvas-soft p-6 shadow-e1">
								<div class="flex items-center justify-between">
									<h3 class="text-display-sm text-body">{tool.name}</h3>
									<span class="rounded-full bg-canvas px-2 py-0.5 text-caption text-mute">Soon</span>
								</div>
								<p class="mt-2 text-body-sm text-mute">{tool.desc}</p>
							</div>
						),
					)
				}
			</div>
		</div>
	</section>

	<!-- ── SEO content (long-form, 0-JS) ────────────────────────────────── -->
	<section class="bg-canvas">
		<div class="container-page py-24">
			<div class="max-w-2xl">
				<p class="font-mono text-caption uppercase tracking-wide text-mute">Why developers choose JSON Beam</p>
				<h2 class="mt-3 text-display-lg">The free online JSON formatter, viewer, and validator — in one place.</h2>
			</div>

			<div class="mt-10 max-w-3xl space-y-10 text-body-md text-body">
				<p>
					JSON Beam is a fast, free <a href="/json-formatter" class="font-medium text-link hover:text-link-deep">online JSON formatter</a>
					built for the data you actually work with. Paste raw, minified, or broken JSON and the formatter instantly
					pretty-prints it with the indentation you prefer — two spaces, four spaces, or tabs — turning a dense,
					unreadable blob into clean, scannable structure. It works equally well as a
					<a href="/json-beautifier" class="font-medium text-link hover:text-link-deep">JSON beautifier</a> and pretty
					printer, and when you need to ship instead of read, the
					<a href="/json-minifier" class="font-medium text-link hover:text-link-deep">JSON minifier</a> strips every byte
					of whitespace for the smallest possible payload. There is nothing to install and nothing to configure: open the
					page and format JSON online in a single click. Whether you are cleaning up an API response, a tangled
					<code class="font-mono text-body-sm text-ink">package.json</code>, or a single line copied from a log, you get
					clean, valid output in seconds.
				</p>

				<div>
					<h3 class="text-display-sm text-ink">Validate, repair, and edit in one surface</h3>
					<p class="mt-3">
						A good formatter does more than indent. The built-in
						<a href="/json-validator" class="font-medium text-link hover:text-link-deep">JSON validator</a> checks your
						document against the JSON specification and underlines the exact position and reason it fails to parse, so
						you stop hunting for the stray comma or missing bracket. When the input is genuinely broken,
						<a href="/json-repair" class="font-medium text-link hover:text-link-deep">JSON repair</a> automatically fixes
						the most common mistakes — trailing commas, single quotes, comments, and unquoted keys — then re-formats the
						clean result. For hands-on work, the full
						<a href="/json-editor" class="font-medium text-link hover:text-link-deep">JSON editor</a> combines syntax
						highlighting, live validation, formatting, and repair in one keyboard-friendly workspace — an online JSON
						editor that feels like your code editor, not a web form.
					</p>
				</div>

				<div>
					<h3 class="text-display-sm text-ink">View and visualize JSON your way</h3>
					<p class="mt-3">
						Big or unfamiliar payloads are far easier to read visually. The
						<a href="/json-viewer" class="font-medium text-link hover:text-link-deep">JSON viewer</a> renders your data
						as a collapsible, color-coded tree where every key shows its child count and any path can be copied with a
						click — a genuinely useful online JSON viewer for exploring API responses. For structure at a glance, the
						<a href="/json-visualizer" class="font-medium text-link hover:text-link-deep">JSON visualizer</a> draws the
						same document as a pan-and-zoom node graph, and the
						<a href="/json-table-viewer" class="font-medium text-link hover:text-link-deep">table viewer</a> presents
						arrays of objects as sortable, filterable rows and columns. Whichever view you pick, your edits round-trip
						losslessly across all of them.
					</p>
				</div>

				<div>
					<h3 class="text-display-sm text-ink">Compare, convert, and reshape</h3>
					<p class="mt-3">
						When two responses should match but don't, the
						<a href="/json-diff" class="font-medium text-link hover:text-link-deep">JSON diff</a> performs a
						structure-aware, semantic comparison and highlights exactly what was added, removed, or changed — far
						clearer than a plain text diff. Moving data between systems is just as quick: the
						<a href="/json-to-csv" class="font-medium text-link hover:text-link-deep">JSON to CSV converter</a> flattens
						nested objects into spreadsheet-ready rows, and you can also
						<a href="/json-to-yaml" class="font-medium text-link hover:text-link-deep">convert JSON to YAML</a> or
						generate <a href="/json-to-typescript" class="font-medium text-link hover:text-link-deep">TypeScript</a> and
						<a href="/json-to-go" class="font-medium text-link hover:text-link-deep">Go</a> types from a sample document.
						Whether you are turning text into JSON, reshaping an export, or fixing JSON copied from a log, the right tool
						is one click away. Pasting loosely-formatted text or a stringified, single-quoted blob? Repair rewrites that
						almost-JSON into a valid document, so converting a string or a JavaScript object literal into clean JSON is
						effortless.
					</p>
				</div>

				<div>
					<h3 class="text-display-sm text-ink">Private, fast, and free forever</h3>
					<p class="mt-3">
						Most importantly, every one of these tools runs entirely in your browser. Whether you paste an API key, a
						customer record, or a proprietary config file, your data is never uploaded, logged, or sent anywhere — you
						can even disconnect from the internet and keep working. JSON Beam is engineered to stay smooth on files into
						the tens of megabytes, where typical online formatters freeze, and it is completely free with no
						account and no usage limits. There are no file-size caps, no watermarks, and no upsells — just a fast,
						dependable JSON toolkit you can reach for every day. If you have been looking for the best free JSON formatter
						and viewer that respects your privacy, this is it.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ── FAQ ──────────────────────────────────────────────────────────── -->
	<section id="faq" class="scroll-mt-20 bg-canvas-soft">
		<div class="container-page grid gap-x-12 gap-y-8 py-24 lg:grid-cols-[1fr_1.7fr]">
			<div>
				<p class="font-mono text-caption uppercase tracking-wide text-mute">FAQ</p>
				<h2 class="mt-3 text-display-lg">Questions, answered.</h2>
			</div>
			<div class="divide-y divide-hairline border-t border-hairline">
				{
					faqs.map((faq) => (
						<details class="group py-5">
							<summary class="flex cursor-pointer items-center justify-between gap-4 text-body-md font-medium text-ink marker:hidden [&::-webkit-details-marker]:hidden">
								{faq.question}
								<span class="text-mute transition-transform group-open:rotate-45" aria-hidden="true">+</span>
							</summary>
							<p class="mt-3 text-body-md text-body">{faq.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<style is:global>
		/* Hero mockup syntax tokens — all from the brand palette, on the ink card.
		   Global (class-scoped) because the spans are injected via set:html, which
		   Astro's scoped-style hashing does not reach. */
		.hero-code .k { color: #ededed; }
		.hero-code .s { color: var(--color-cyan); }
		.hero-code .n { color: var(--color-violet-soft); }
		.hero-code .b { color: var(--color-warning); }
		.hero-code .p { color: var(--color-mute); }
	</style>
</Layout>
