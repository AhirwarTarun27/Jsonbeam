---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import MeshGradient from '../components/ui/MeshGradient.astro';
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION, withSlash } from '../consts';
import {
	webSite,
	softwareApplication,
	faqPage,
	organization,
	type FaqItem,
} from '../lib/seo/jsonld';

const title = `${SITE_NAME} — Free Online JSON Formatter, Viewer & Validator`;
const description =
	'Free online JSON formatter, viewer, validator & converter. Beautify, minify, repair, diff & visualize JSON in your browser — private, no upload, no signup.';

const promises = [
	{
		title: 'Private by design',
		body: 'The JSON you paste is processed entirely in your browser — never uploaded, logged, or sent to a server. Like most free sites, the site itself uses cookies for analytics and ads.',
		icon: 'shield',
	},
	{
		title: 'No ceiling',
		body: 'Format and explore files into the tens of megabytes without freezing the tab — where other tools give up.',
		icon: 'layers',
	},
	{
		title: 'Instant',
		body: 'Sub-second load. The editor is usable before the rest of the page has even finished painting.',
		icon: 'bolt',
	},
	{
		title: 'Free forever',
		body: 'No signup, no upload, no usage limits. Advertising keeps the tools free for everyone.',
		icon: 'heart',
	},
];

const tools = [
	{ name: 'JSON Formatter', href: '/json-formatter/', desc: 'Beautify, minify, repair, and validate — the anchor tool.', live: true },
	{ name: 'JSON Validator', href: '/json-validator/', desc: 'Pinpoint syntax errors with line-anchored messages.', live: true },
	{ name: 'JSON Viewer', href: '/json-viewer/', desc: 'Explore JSON as a collapsible, color-coded tree. Copy any path.', live: true },
	{ name: 'JSON Tree Viewer', href: '/json-tree-viewer/', desc: 'Walk deep structures with the full arrow-key tree pattern.', live: true },
	{ name: 'JSON Visualizer', href: '/json-visualizer/', desc: 'See JSON as a pan-and-zoom node graph.', live: true },
	{ name: 'JSON Diff', href: '/json-diff/', desc: 'Compare two documents with a semantic, structure-aware diff.', live: true },
	{ name: 'JSON Repair', href: '/json-repair/', desc: 'Fix trailing commas, single quotes, comments, unquoted keys.', live: true },
	{ name: 'JSON Minifier', href: '/json-minifier/', desc: 'Strip whitespace down to the smallest possible payload.', live: true },
	{ name: 'JSON → CSV / YAML / TS / Go', href: '/json-to-csv/', desc: 'Convert to CSV & YAML, or generate TypeScript and Go types.', live: true },
];

const faqs: FaqItem[] = [
	{
		question: 'Is my JSON uploaded to a server?',
		answer:
			'No. JSON Beam runs entirely in your browser using client-side JavaScript. Your data is never uploaded, transmitted, logged, or stored anywhere. You can confirm this by opening your browser dev tools network tab, or by using the tool fully offline.',
	},
	{
		question: 'Does JSON Beam cost anything?',
		answer:
			'No. Every tool is free, with no account and no usage limits. The site is supported by advertising, which is what keeps it free — and you can verify the privacy claim yourself by opening your browser dev tools network tab while you work, or by disconnecting from the internet entirely.',
	},
	{
		question: 'How large a file can it handle?',
		answer:
			'Far more than typical online formatters. Parsing and formatting are engineered to handle files into the tens of megabytes without freezing the tab, with large-file streaming and virtualization expanding that ceiling further.',
	},
	{
		question: 'Do I need to install anything?',
		answer:
			'No. JSON Beam is a website that works in any modern browser. It can also be installed as a progressive web app and used offline, with no extensions or downloads required.',
	},
];

// Hand-coloured JSON for the hero mockup. Built as strings so literal braces
// don't collide with Astro's expression syntax; rendered via set:html. The two
// snippets mirror the real Formatter and Graph full-screen views.
const fmtSnippet = [
	'<span class="p">{</span>',
	'  <span class="k">"app"</span><span class="p">:</span> <span class="s">"JSON Beam"</span><span class="p">,</span>',
	'  <span class="k">"private"</span><span class="p">:</span> <span class="b">true</span><span class="p">,</span>',
	'  <span class="k">"modes"</span><span class="p">:</span> <span class="p">[</span><span class="s">"text"</span><span class="p">,</span> <span class="s">"tree"</span><span class="p">,</span> <span class="s">"table"</span><span class="p">,</span> <span class="s">"graph"</span><span class="p">]</span><span class="p">,</span>',
	'  <span class="k">"maxFileSizeMB"</span><span class="p">:</span> <span class="n">100</span>',
	'<span class="p">}</span>',
];

const graphSnippet = [
	'<span class="p">{</span>',
	'  <span class="k">"name"</span><span class="p">:</span> <span class="s">"JSON Beam"</span><span class="p">,</span>',
	'  <span class="k">"private"</span><span class="p">:</span> <span class="b">true</span><span class="p">,</span>',
	'  <span class="k">"version"</span><span class="p">:</span> <span class="n">2</span><span class="p">,</span>',
	'  <span class="k">"modes"</span><span class="p">:</span> <span class="p">[</span><span class="s">"text"</span><span class="p">,</span> <span class="s">"tree"</span><span class="p">,</span> <span class="s">"table"</span><span class="p">,</span> <span class="s">"graph"</span><span class="p">]</span><span class="p">,</span>',
	'  <span class="k">"limits"</span><span class="p">:</span> <span class="p">{</span> <span class="k">"maxFileSizeMB"</span><span class="p">:</span> <span class="n">100</span><span class="p">,</span> <span class="k">"workers"</span><span class="p">:</span> <span class="n">4</span> <span class="p">}</span><span class="p">,</span>',
	'  <span class="k">"users"</span><span class="p">:</span> <span class="p">[</span>',
	'    <span class="p">{</span> <span class="k">"id"</span><span class="p">:</span> <span class="n">1</span><span class="p">,</span> <span class="k">"name"</span><span class="p">:</span> <span class="s">"Ada"</span> <span class="p">}</span><span class="p">,</span>',
	'    <span class="p">{</span> <span class="k">"id"</span><span class="p">:</span> <span class="n">2</span><span class="p">,</span> <span class="k">"name"</span><span class="p">:</span> <span class="s">"Linus"</span> <span class="p">}</span>',
	'  <span class="p">]</span><span class="p">,</span>',
	'  <span class="k">"tags"</span><span class="p">:</span> <span class="n">null</span>',
	'<span class="p">}</span>',
];

const jsonLd = [
	webSite(),
	organization(),
	softwareApplication({ name: SITE_NAME, description: SITE_DESCRIPTION, url: SITE_URL }),
	faqPage(faqs),
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
	<!-- ── Hero ─────────────────────────────────────────────────────────── -->
	<section class="relative overflow-hidden">
		<MeshGradient />
		<div class="container-page relative z-10 flex flex-col items-center pt-24 pb-16 text-center sm:pt-28">
			<span
				class="inline-flex items-center gap-2 rounded-full bg-canvas-soft px-3 py-1 font-mono text-caption text-body shadow-e1"
			>
				<span class="inline-block h-1.5 w-1.5 rounded-full bg-cyan-deep"></span>
				100% client-side · nothing uploaded
			</span>

			<h1 class="mt-6 max-w-3xl text-balance text-display-xl">
				The JSON workbench that never leaves your browser.
			</h1>

			<p class="mt-5 max-w-2xl text-body-lg text-body">
				Format, validate, repair, and convert JSON instantly — free, private, and
				fast enough for the files other tools choke on.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<Button href="/json-formatter/">Open the formatter</Button>
				<Button href="#tools" variant="secondary">Explore tools</Button>
			</div>

			<p class="mt-5 font-mono text-caption text-mute">
				No upload · No signup · Works offline · Your JSON carries across tools
			</p>

			<!-- Live workbench mockup: full-screen Formatter ⇄ Graph, auto cross-fading.
			     Pure CSS/SVG — 0 KB JS — faithful to the real full-screen views. -->
			<div
				class="hero-wb relative mt-14 h-[330px] w-full max-w-5xl text-left sm:h-[420px] lg:h-[500px]"
				role="img"
				aria-label="JSON Beam in full-screen mode, toggling between the Formatter and the Graph visualizer"
			>
				<!-- ░░ GRAPH screen (lower layer) ░░ -->
				<div class="hero-screen hero-screen-graph" aria-hidden="true">
					<!-- slim brand bar -->
					<div class="hero-bar">
						<span class="hero-chip">{'{}'}</span>
						<span class="hero-brand"><span class="hidden lg:inline">JSON&nbsp;Beam <span class="hero-dot">·</span> </span><span class="hero-tool-graph">Graph</span></span>
						<span class="hero-search"><svg viewBox="0 0 16 16" width="11" height="11" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.3"/><path d="m11 11 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span class="hidden sm:inline">Search</span><span class="hero-kbd hidden sm:inline">Ctrl K</span></span>
						<span class="hero-sep hidden md:block"></span>
						<span class="hero-btn hidden md:inline-flex">Expand all</span>
						<span class="hero-btn hidden lg:inline-flex">Collapse all</span>
						<span class="hero-sep hidden lg:block"></span>
						<span class="hero-btn hidden sm:inline-flex">Fit</span>
						<span class="hero-zoom hidden sm:inline-flex"><span class="hero-zbtn">−</span><span class="hero-zval">121%</span><span class="hero-zbtn">+</span></span>
						<span class="hero-btn hidden lg:inline-flex">Layout: →</span>
						<span class="hero-cluster">
							<span class="hero-btn hidden sm:inline-flex">SVG</span>
							<span class="hero-btn hidden sm:inline-flex">PNG</span>
							<span class="hero-btn hero-ico"><svg viewBox="0 0 20 20" width="13" height="13" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.5"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M15.8 4.2l-1.4 1.4M5.6 14.4l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
							<span class="hero-btn hidden lg:inline-flex">Sample</span>
							<span class="hero-btn hidden md:inline-flex">Copy JSON</span>
							<span class="hero-btn hidden lg:inline-flex">Clear</span>
							<span class="hero-sep"></span>
							<span class="hero-btn hero-exit"><svg viewBox="0 0 20 20" width="12" height="12" fill="none" aria-hidden="true"><path d="M8 3H4.5A1.5 1.5 0 0 0 3 4.5V8M12 3h3.5A1.5 1.5 0 0 1 17 4.5V8M8 17H4.5A1.5 1.5 0 0 1 3 15.5V12M12 17h3.5a1.5 1.5 0 0 0 1.5-1.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Exit<span class="hero-kbd hidden sm:inline">Esc</span></span>
						</span>
					</div>
					<!-- path bar -->
					<div class="hero-pathbar">
						<span class="hero-path-label">Path</span>
						<code class="hero-path-val">$</code>
						<span class="hero-ico hero-path-copy"><svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.4" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" stroke="currentColor" stroke-width="1.3"/></svg></span>
						<span class="hero-find"><svg viewBox="0 0 16 16" width="11" height="11" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.3"/><path d="m11 11 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>Find key or value…<span class="hero-find-nav">↑↓</span></span>
					</div>
					<!-- two-pane body: raw JSON + node graph -->
					<div class="hero-graph-body">
						<pre class="hero-graph-code hidden md:block" set:html={graphSnippet.join('\n')} />
						<div class="hero-graph-canvas">
							<svg viewBox="0 0 920 540" class="h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
								<!-- connectors -->
								<g fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="1.4">
									<path d="M233,200 C290,200 290,98 315,98" />
									<path d="M233,238 C290,238 290,235 315,235" />
									<path d="M233,276 C290,276 290,340 315,340" />
									<path d="M435,332 C510,332 510,316 580,316" />
									<path d="M435,356 C510,356 510,442 580,442" />
								</g>
								<!-- collapse handles -->
								<g>
									<circle cx="233" cy="238" r="11" fill="#1b1b1b" stroke="rgba(255,255,255,0.28)" />
									<line x1="228" y1="238" x2="238" y2="238" stroke="#9a9a9a" stroke-width="1.6" stroke-linecap="round" />
									<circle cx="435" cy="341" r="11" fill="#1b1b1b" stroke="rgba(255,255,255,0.28)" />
									<line x1="430" y1="341" x2="440" y2="341" stroke="#9a9a9a" stroke-width="1.6" stroke-linecap="round" />
								</g>
								<!-- node boxes -->
								<foreignObject x="28" y="120" width="205" height="236">
									<div class="hero-node">
										<div><span class="nk">name</span><span class="np">: </span><span class="ns">"JSON Beam"</span></div>
										<div><span class="nk">private</span><span class="np">: </span><span class="nb">true</span></div>
										<div><span class="nk">version</span><span class="np">: </span><span class="nn">2</span></div>
										<div><span class="nk">modes</span> <span class="nc">[4]</span></div>
										<div><span class="nk">limits</span> <span class="nc">{'{2}'}</span></div>
										<div><span class="nk">users</span> <span class="nc">[2]</span></div>
										<div><span class="nk">tags</span><span class="np">: </span><span class="nb">null</span></div>
									</div>
								</foreignObject>
								<foreignObject x="315" y="34" width="175" height="128">
									<div class="hero-node">
										<div><span class="nc">0</span><span class="np">: </span><span class="ns">"text"</span></div>
										<div><span class="nc">1</span><span class="np">: </span><span class="ns">"tree"</span></div>
										<div><span class="nc">2</span><span class="np">: </span><span class="ns">"table"</span></div>
										<div><span class="nc">3</span><span class="np">: </span><span class="ns">"graph"</span></div>
									</div>
								</foreignObject>
								<foreignObject x="315" y="196" width="220" height="78">
									<div class="hero-node">
										<div><span class="nk">maxFileSizeMB</span><span class="np">: </span><span class="nn">100</span></div>
										<div><span class="nk">workers</span><span class="np">: </span><span class="nn">4</span></div>
									</div>
								</foreignObject>
								<foreignObject x="315" y="300" width="120" height="80">
									<div class="hero-node">
										<div><span class="nc">{'0  {3}'}</span></div>
										<div><span class="nc">{'1  {3}'}</span></div>
									</div>
								</foreignObject>
								<foreignObject x="580" y="262" width="185" height="108">
									<div class="hero-node">
										<div><span class="nk">id</span><span class="np">: </span><span class="nn">1</span></div>
										<div><span class="nk">name</span><span class="np">: </span><span class="ns">"Ada"</span></div>
										<div><span class="nk">admin</span><span class="np">: </span><span class="nb">true</span></div>
									</div>
								</foreignObject>
								<foreignObject x="580" y="388" width="185" height="108">
									<div class="hero-node">
										<div><span class="nk">id</span><span class="np">: </span><span class="nn">2</span></div>
										<div><span class="nk">name</span><span class="np">: </span><span class="ns">"Linus"</span></div>
										<div><span class="nk">admin</span><span class="np">: </span><span class="nb">false</span></div>
									</div>
								</foreignObject>
								<!-- minimap -->
								<g>
									<rect x="784" y="412" width="118" height="104" rx="8" fill="rgba(255,255,255,0.025)" stroke="rgba(255,255,255,0.10)" />
									<rect x="793" y="444" width="20" height="34" rx="2" fill="rgba(80,227,194,0.22)" />
									<rect x="824" y="428" width="18" height="14" rx="2" fill="rgba(80,227,194,0.20)" />
									<rect x="824" y="448" width="18" height="12" rx="2" fill="rgba(80,227,194,0.20)" />
									<rect x="824" y="466" width="18" height="14" rx="2" fill="rgba(80,227,194,0.20)" />
									<rect x="857" y="458" width="28" height="12" rx="2" fill="rgba(80,227,194,0.16)" />
									<rect x="857" y="476" width="28" height="12" rx="2" fill="rgba(80,227,194,0.16)" />
								</g>
							</svg>
						</div>
					</div>
					<!-- status bar -->
					<div class="hero-status">
						<span class="hero-status-dot"></span>
						<span class="hero-status-ok">Valid JSON</span>
						<span class="hero-status-meta hidden sm:inline">· 7 keys · 289 chars · 6 nodes</span>
						<span class="hero-chip-kbd hidden lg:inline">drag pan</span>
						<span class="hero-chip-kbd hidden lg:inline">scroll zoom</span>
						<span class="hero-chip-kbd hidden lg:inline">Tab nodes</span>
						<span class="hero-status-priv"><svg viewBox="0 0 20 20" width="12" height="12" fill="none" aria-hidden="true"><path d="M10 2 3.5 4.5v4c0 3.7 2.7 7.1 6.5 8 3.8-.9 6.5-4.3 6.5-8v-4L10 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>Processed locally<span class="hidden sm:inline"> — nothing uploaded</span></span>
					</div>
				</div>

				<!-- ░░ FORMATTER screen (upper layer) ░░ -->
				<div class="hero-screen hero-screen-fmt" aria-hidden="true">
					<!-- slim brand bar -->
					<div class="hero-bar">
						<span class="hero-chip">{'{}'}</span>
						<span class="hero-brand"><span class="hidden lg:inline">JSON&nbsp;Beam <span class="hero-dot">·</span> </span><span class="hero-tool-fmt">Formatter</span></span>
						<span class="hero-search"><svg viewBox="0 0 16 16" width="11" height="11" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.3"/><path d="m11 11 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span class="hidden sm:inline">Search</span><span class="hero-kbd hidden sm:inline">Ctrl K</span></span>
						<span class="hero-sep hidden sm:block"></span>
						<span class="hero-btn hero-btn-on">Format</span>
						<span class="hero-btn hidden sm:inline-flex">Minify</span>
						<span class="hero-btn hidden sm:inline-flex">Repair</span>
						<span class="hero-btn hidden sm:inline-flex">Validate</span>
						<span class="hero-sep hidden lg:block"></span>
						<span class="hero-btn hidden lg:inline-flex">Indent <span class="hero-select">2 spaces ▾</span></span>
						<span class="hero-cluster">
							<span class="hero-btn hero-ico"><svg viewBox="0 0 20 20" width="13" height="13" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.5"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M15.8 4.2l-1.4 1.4M5.6 14.4l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
							<span class="hero-btn hidden sm:inline-flex">Sample</span>
							<span class="hero-btn hidden md:inline-flex">Copy</span>
							<span class="hero-btn hidden lg:inline-flex">Download</span>
							<span class="hero-btn hidden lg:inline-flex">Clear</span>
							<span class="hero-sep"></span>
							<span class="hero-btn hero-exit"><svg viewBox="0 0 20 20" width="12" height="12" fill="none" aria-hidden="true"><path d="M8 3H4.5A1.5 1.5 0 0 0 3 4.5V8M12 3h3.5A1.5 1.5 0 0 1 17 4.5V8M8 17H4.5A1.5 1.5 0 0 1 3 15.5V12M12 17h3.5a1.5 1.5 0 0 0 1.5-1.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Exit<span class="hero-kbd hidden sm:inline">Esc</span></span>
						</span>
					</div>
					<!-- line-numbered editor -->
					<div class="hero-fmt-body">
						{
							fmtSnippet.map((line, i) => (
								<div class:list={['hero-fmt-line', i === fmtSnippet.length - 1 && 'is-active']}>
									<span class="hero-fmt-num">{i + 1}</span>
									<code class="hero-fmt-code" set:html={line} />
								</div>
							))
						}
					</div>
					<!-- status bar -->
					<div class="hero-status">
						<span class="hero-status-dot"></span>
						<span class="hero-status-ok">Valid JSON</span>
						<span class="hero-status-meta hidden sm:inline">· 6 lines · 114 chars</span>
						<span class="hero-status-priv"><svg viewBox="0 0 20 20" width="12" height="12" fill="none" aria-hidden="true"><path d="M10 2 3.5 4.5v4c0 3.7 2.7 7.1 6.5 8 3.8-.9 6.5-4.3 6.5-8v-4L10 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>Processed locally<span class="hidden sm:inline"> — nothing uploaded</span></span>
					</div>
				</div>

				<!-- floating label, reinforces the full-screen feature -->
				<span class="hero-fs-badge">
					<svg viewBox="0 0 20 20" width="12" height="12" fill="none" aria-hidden="true"><path d="M8 3H4.5A1.5 1.5 0 0 0 3 4.5V8M12 3h3.5A1.5 1.5 0 0 1 17 4.5V8M8 17H4.5A1.5 1.5 0 0 1 3 15.5V12M12 17h3.5a1.5 1.5 0 0 0 1.5-1.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
					Full-screen mode
				</span>
			</div>
		</div>
	</section>

	<!-- ── Brand promises ───────────────────────────────────────────────── -->
	<section class="bg-canvas-soft">
		<div class="container-page py-24">
			<div class="max-w-2xl">
				<p class="font-mono text-caption uppercase tracking-wide text-mute">Why JSON Beam</p>
				<h2 class="mt-3 text-display-lg">Built for the JSON you actually work with.</h2>
			</div>
			<div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					promises.map((p) => (
						<div class="rounded-md bg-canvas p-6 shadow-e3">
