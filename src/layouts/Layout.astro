---
import '../styles/global.css';

// Self-hosted Geist (no external font requests → faster + privacy-respecting).
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-mono/400.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
}

const { title, description, image, jsonLd, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			jsonLd={jsonLd}
			noindex={noindex}
		/>
	</head>
	<body class="min-h-dvh bg-canvas text-ink antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-ink focus:px-4 focus:py-2 focus:text-body-sm focus:text-on-primary"
		>
			Skip to content
		</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
