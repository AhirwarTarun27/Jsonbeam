---
import '../styles/global.css';

// Self-hosted Geist (no external font requests → faster + privacy-respecting).
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-mono/400.css';

import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
	/** Pass through to BaseHead — trust/legal pages ship no ad library. */
	ads?: boolean;
	/**
	 * Tool pages opt in to the theme boot script so a persisted light theme is
	 * applied before first paint (no dark→light flash). Marketing/content pages
	 * leave it off, keeping their 0-KB-app-JS contract (only ld+json inline).
	 */
	themed?: boolean;
}

const { title, description, image, jsonLd, noindex, ads, themed } = Astro.props;

// Apply the persisted editor theme on <html> before the body paints. The class
// only drives island styles (lib/island-theme); page chrome has no dark rules,
// so this is a no-op for layout. Default stays dark — the on-brand surface.
const THEME_BOOT =
	"try{if(localStorage.getItem('jb-theme')==='light')document.documentElement.classList.add('jb-theme-light')}catch(e){}";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			jsonLd={jsonLd}
			noindex={noindex}
			ads={ads}
		/>
		{themed && <script is:inline set:html={THEME_BOOT} />}
	</head>
	<body class="min-h-dvh bg-canvas text-ink antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-ink focus:px-4 focus:py-2 focus:text-body-sm focus:text-on-primary"
		>
			Skip to content
		</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
