    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.7",
    "jmespath": "^0.16.0",
    "jsonpath-plus": "^10.4.0",
    "jsonrepair": "3.14.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/jmespath": "^0.15.2",
    "playwright": "^1.61.0",
