{
  "name": "jsonbeam",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:budget": "node scripts/check-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
